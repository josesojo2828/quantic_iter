generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  email        String     @unique
  password     String
  firstName    String
  lastName     String
  isActive     Boolean    @default(true)
  lastTenantId String?    @db.ObjectId
  avatarUrl    String?
  
  // New Multitenancy Relation
  userRoles    UserRole[]

  // Legacy/Owner relation (can be kept or migrated to UserRole)
  managedTenants Tenant[] @relation("TenantOwner")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model UserRole {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  roleId    String   @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  tenantId  String?  @db.ObjectId
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  branchId  String?  @db.ObjectId
  branch    Branch?  @relation(fields: [branchId], references: [id])
  
  extraPermissions String[] // Manual overrides for this specific user in this specific tenant
  
  @@unique([userId, tenantId, roleId])
  @@map("user_roles")
}

model Tenant {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String        @unique
  isActive      Boolean       @default(true)
  mentor_ownerId       String?       @db.ObjectId
  mentor_owner         User?         @relation("TenantOwner", fields: [mentor_ownerId], references: [id])
  
  // Metadata
  address       String?
  phone         String?
  contactEmail  String?
  website       String?
  logo          String?
  legalName     String?
  taxId         String?
  bio           String?
  specialty     String?
  socialLinks   Json?

  userRoles     UserRole[]
  branches      Branch[]
  subscription Subscription?
  subscriptionHistory SubscriptionHistory[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@map("tenants")
}

model Branch {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  phone     String?
  tenantId  String    @db.ObjectId
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("branches")
}


model SubscriptionPlan {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String         @unique
  description   String?
  price         Float
  billingCycle  String         @default("MONTHLY") // MONTHLY, YEARLY
  config        Json? // Used for limits: { maxUsers: 10, maxMentees: 50, etc. }
  isActive      Boolean        @default(true)
  subscriptions Subscription[] @relation("CurrentPlan")
  nextSubscriptions Subscription[] @relation("NextPlan")
  subscriptionHistory SubscriptionHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String             @unique @db.ObjectId
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  status    SubscriptionStatus @default(ACTIVE)
  expiresAt DateTime
  customConfig Json?           // Used for add-ons: { extraUsers: 5, extraFeatures: ['inventory'] }
  
  planId    String             @db.ObjectId
  plan      SubscriptionPlan   @relation("CurrentPlan", fields: [planId], references: [id])
  
  nextPlanId String?           @db.ObjectId
  nextPlan   SubscriptionPlan? @relation("NextPlan", fields: [nextPlanId], references: [id])

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  @@map("subscriptions")
}

model SubscriptionHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  planId    String   @db.ObjectId
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  
  action    String   // ACTIVATION, RENEWAL, UPGRADE, DOWNGRADE, CANCELLATION
  price     Float
  config    Json?
  
  startDate DateTime
  endDate   DateTime
  
  createdAt DateTime @default(now())

  @@map("subscription_history")
}

model Invitation {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  token      String    @unique
  roleId     String    @db.ObjectId
  tenantId   String    @db.ObjectId
  branchId   String?   @db.ObjectId
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("invitations")
}


model Permission {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  action      String    @unique // e.g., 'inventory.view'
  module      String? // e.g., 'inventory'
  description String?
  roles       Role[]    @relation(fields: [roleIds], references: [id])
  roleIds     String[]  @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("permissions")
}

model Role {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String       @unique // e.g., 'admin', 'facilitator', 'mentor_owner'
  description   String?
  tenantId      String?      @db.ObjectId // If null, it's a GLOBAL role (Level 0/1)
  userRoles     UserRole[]
  permissions   Permission[] @relation(fields: [permissionIds], references: [id])
  permissionIds String[]     @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@map("roles")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}
