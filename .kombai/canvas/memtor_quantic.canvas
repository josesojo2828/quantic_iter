      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --primary: #7A8CEB;\n        --bg-start: #F4F6FA;\n        --bg-end: #EDF0F5;\n        --slate-950: #0F172A;\n        --slate-600: #475569;\n        --white: #FFFFFF;\n    }\n\n    .font-outfit { font-family: 'Outfit', sans-serif; }\n    .font-dm { font-family: 'DM Sans', sans-serif; }\n\n    .glass-card {\n        background: rgba(255, 255, 255, 0.75);\n        backdrop-filter: blur(16px);\n        -webkit-backdrop-filter: blur(16px);\n        border: 1px solid rgba(255, 255, 255, 0.5);\n        box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.05);\n        border-radius: 32px;\n    }\n\n    .pill-switch-shadow {\n        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);\n    }\n\n    .s-curve-svg {\n        position: absolute;\n        top: 0;\n        left: 50%;\n        transform: translateX(-50%);\n        width: 100%;\n        height: 100%;\n        pointer-events: none;\n        z-index: 0;\n    }\n\n    .bg-gradient-soft {\n        background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);\n    }\n\n    /* Custom scrollbar override within body context */\n    body::-webkit-scrollbar { width: 8px; }\n    body::-webkit-scrollbar-track { background: var(--bg-start); }\n    body::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 10px; }\n</style>\n\n<div class=\"bg-gradient-soft min-h-screen font-outfit overflow-x-clip\" data-kid=\"1\">\n    \n    <header id=\"pill-nav\" class=\"fixed top-6 left-1/2 -translate-x-1/2 w-[90%] max-w-4xl flex items-center justify-between px-6 py-3 glass-card border-white/40 shadow-xl z-50\" data-kid=\"2\">\n        <div class=\"flex items-center gap-2 font-bold text-2xl tracking-tight\" data-kid=\"3\">\n            <i class=\"ti ti-activity text-[var(--primary)] text-3xl\" data-kid=\"4\"></i>\n            <span data-kid=\"5\">ITER</span>\n        </div>\n        \n        <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-[var(--slate-600)]\" data-kid=\"6\">\n            <a href=\"#features\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"7\">Producto</a>\n            <a href=\"#how-it-works\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"8\">Metodología</a>\n            <a href=\"#use-cases\" class=\"hover:text-[var(--primary)] transition-colors\" data-kid=\"9\">Casos</a>\n        </nav>\n\n        <div class=\"flex items-center gap-4\" data-kid=\"10\">\n            <button class=\"px-5 py-2 text-sm font-semibold border border-slate-200 rounded-full hover:bg-white transition-colors cursor-pointer\" data-kid=\"11\">\n                Acceso Mentor\n            </button>\n        </div>\n    </header>\n\n    <main data-kid=\"12\">\n        \n        <section class=\"relative pt-48 pb-32 px-6 overflow-hidden\" data-kid=\"13\">\n            \n            <div data-scroll data-scroll-speed=\"-0.3\" class=\"absolute -top-24 -left-24 w-96 h-96 bg-[var(--primary)]/10 rounded-full blur-3xl -z-10\" data-kid=\"14\"></div>\n            <div data-scroll data-scroll-speed=\"0.2\" class=\"absolute top-1/2 -right-24 w-80 h-80 bg-indigo-200/20 rounded-full blur-3xl -z-10\" data-kid=\"15\"></div>\n\n            <div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"16\">\n                \n                \n                <div class=\"relative order-2 lg:order-1 hero-mockup-reveal\" data-kid=\"17\">\n                    <div class=\"glass-card p-8 relative z-10\" data-kid=\"18\">\n                        <div class=\"flex justify-between items-center mb-8\" data-kid=\"19\">\n                            <div data-kid=\"20\">\n                                <h3 class=\"font-bold text-xl\" data-kid=\"21\">Dashboard de Salud</h3>\n                                <p class=\"text-sm text-[var(--slate-600)]\" data-kid=\"22\">Progreso de Cliente: <span class=\"font-bold\" data-kid=\"23\">Juan Pérez</span></p>\n                            </div>\n                            <span class=\"px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full\" data-kid=\"24\">Activo</span>\n                        </div>\n\n                        \n                        <div id=\"mockup-gym\" class=\"space-y-6\" data-kid=\"25\">\n                            <div class=\"h-56 rounded-2xl overflow-hidden relative\" data-kid=\"26\">\n                                <img src=\"https://images.unsplash.com/photo-1772257495824-a7e233ca790c?auto=format&w=800&q=80&fit=crop\" alt=\"Chart\" class=\"w-full h-full object-cover\" decoding=\"async\" loading=\"lazy\" data-kid=\"27\">\n                                <div class=\"absolute inset-0 bg-white/10 backdrop-blur-[2px]\" data-kid=\"28\"></div>\n                                <div class=\"absolute bottom-4 left-4 right-4 p-4 glass-card bg-white/80 rounded-xl flex justify-between items-center\" data-kid=\"29\">\n                                    <span class=\"text-sm font-bold\" data-kid=\"30\">Frecuencia Cardiaca</span>\n                                    <span class=\"text-[var(--primary)] font-bold\" data-kid=\"31\">142 BPM</span>\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-3 gap-4 font-dm\" data-kid=\"32\">\n                                <div class=\"p-4 bg-white/40 rounded-2xl border border-white/60\" data-kid=\"33\">\n                                    <p class=\"text-[var(--slate-600)] text-[10px] uppercase font-bold\" data-kid=\"34\">Grasa</p>\n                                    <p class=\"text-lg font-bold\" data-kid=\"35\">-1.2%</p>\n                                </div>\n                                <div class=\"p-4 bg-white/40 rounded-2xl border border-white/60\" data-kid=\"36\">\n                                    <p class=\"text-[var(--slate-600)] text-[10px] uppercase font-bold\" data-kid=\"37\">Músculo</p>\n                                    <p class=\"text-lg font-bold\" data-kid=\"38\">+0.8kg</p>\n                                </div>\n                                <div class=\"p-4 bg-white/40 rounded-2xl border border-white/60\" data-kid=\"39\">\n                                    <p class=\"text-[var(--slate-600)] text-[10px] uppercase font-bold\" data-kid=\"40\">Agua</p>\n                                    <p class=\"text-lg font-bold\" data-kid=\"41\">62%</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div id=\"mockup-mentor\" class=\"hidden space-y-6\" data-kid=\"42\">\n                            <div class=\"h-56 rounded-2xl overflow-hidden relative flex flex-col justify-center items-center bg-indigo-50 border border-indigo-100 p-8\" data-kid=\"43\">\n                                <i class=\"ti ti-target-arrow text-5xl text-[var(--primary)] mb-4\" data-kid=\"44\"></i>\n                                <h4 class=\"font-bold text-lg text-center\" data-kid=\"45\">Objetivos Cumplidos</h4>\n                                <div class=\"w-full bg-white/50 h-2 rounded-full mt-4\" data-kid=\"46\">\n                                    <div class=\"bg-[var(--primary)] h-full w-[85%] rounded-full\" data-kid=\"47\"></div>\n                                </div>\n                                <p class=\"mt-2 text-xs font-bold text-[var(--slate-600)]\" data-kid=\"48\">85% Completado</p>\n                            </div>\n                            <div class=\"space-y-3\" data-kid=\"49\">\n                                <div class=\"p-3 bg-white/40 rounded-xl border border-white/60 flex items-center gap-3\" data-kid=\"50\">\n                                    <i class=\"ti ti-circle-check-filled text-emerald-500\" data-kid=\"51\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"52\">Módulo 1: Fundamentos</span>\n                                </div>\n                                <div class=\"p-3 bg-white/40 rounded-xl border border-white/60 flex items-center gap-3\" data-kid=\"53\">\n                                    <i class=\"ti ti-circle-check-filled text-emerald-500\" data-kid=\"54\"></i>\n                                    <span class=\"text-sm font-medium\" data-kid=\"55\">Módulo 2: Escalamiento</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"order-1 lg:order-2 space-y-10\" id=\"hero-content\" data-kid=\"56\">\n                    <h1 class=\"text-5xl lg:text-7xl font-bold leading-[1.1] tracking-tight text-slate-900 hero-item\" data-kid=\"57\">\n                        Tu visión, <br data-kid=\"58\">\n                        <span class=\"text-[var(--primary)]\" data-kid=\"59\">escalada.</span>\n                    </h1>\n                    <p class=\"text-lg lg:text-xl text-[var(--slate-600)] max-w-lg leading-relaxed font-dm hero-item\" data-kid=\"60\">\n                        Diseñamos el entorno perfecto para que gestiones tu comunidad de fitness o mentoría con precisión quirúrgica y estética premium.\n                    </p>\n\n                    \n                    <div class=\"relative w-fit hero-item\" data-kid=\"61\">\n                        <div class=\"p-1.5 bg-slate-200/40 rounded-full flex items-center relative pill-switch-shadow border border-slate-200/50\" data-kid=\"62\">\n                            <div id=\"switch-indicator\" class=\"absolute top-1.5 left-1.5 h-[calc(100%-12px)] w-[calc(50%-6px)] bg-white rounded-full shadow-md z-0\" data-kid=\"63\"></div>\n                            <button id=\"btn-gym\" class=\"relative z-10 px-8 py-3 text-sm font-bold text-slate-900 cursor-pointer whitespace-nowrap\" data-kid=\"64\">\n                                [ Gimnasios y Fitness ]\n                            </button>\n                            <button id=\"btn-mentor\" class=\"relative z-10 px-8 py-3 text-sm font-bold text-slate-500 cursor-pointer whitespace-nowrap\" data-kid=\"65\">\n                                Academias y Mentores\n                            </button>\n                        </div>\n                    </div>\n\n                    <div class=\"flex flex-col sm:flex-row gap-4 hero-item\" data-kid=\"66\">\n                        <button class=\"bg-[var(--primary)] text-white px-10 py-5 rounded-full font-bold shadow-2xl shadow-[var(--primary)]/25 hover:scale-105 transition-transform active:scale-95 cursor-pointer\" data-kid=\"67\">\n                            Comenzar ahora\n                        </button>\n                        <button class=\"flex items-center gap-2 px-10 py-5 rounded-full font-bold text-slate-600 hover:bg-white/50 transition-colors cursor-pointer\" data-kid=\"68\">\n                            <i class=\"ti ti-player-play-filled\" data-kid=\"69\"></i>\n                            Ver demo\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"use-cases\" class=\"py-32 px-6\" data-kid=\"70\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"71\">\n                <div class=\"text-center mb-20 space-y-4\" data-kid=\"72\">\n                    <h2 class=\"text-4xl lg:text-5xl font-bold\" data-kid=\"73\">Un ecosistema diseñado para ganar</h2>\n                    <p class=\"text-[var(--slate-600)] max-w-2xl mx-auto text-lg font-dm\" data-kid=\"74\">Todo lo que necesitas para que tu marca destaque y tus clientes obtengan resultados excepcionales.</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-5 md:grid-rows-3 gap-6\" id=\"giant-cluster\" data-kid=\"75\">\n                    \n                    <div class=\"md:col-span-3 md:row-span-3 glass-card overflow-hidden group relative min-h-[500px] bento-item\" data-kid=\"76\">\n                        <img src=\"https://images.pexels.com/photos/4908620/pexels-photo-4908620.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\" alt=\"Training\" class=\"absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90\" decoding=\"async\" loading=\"lazy\" data-kid=\"77\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-white via-white/10 to-transparent\" data-kid=\"78\"></div>\n                        <div class=\"absolute bottom-0 left-0 p-12 w-full\" data-kid=\"79\">\n                            <div class=\"inline-block px-4 py-1.5 bg-[var(--primary)] text-white text-xs font-bold rounded-full mb-6\" data-kid=\"80\">Fitness Hub</div>\n                            <h3 class=\"text-4xl font-bold mb-4\" data-kid=\"81\">Rutinas de Acondicionamiento Físico</h3>\n                            <p class=\"text-slate-700 text-lg max-w-lg font-dm\" data-kid=\"82\">Crea planes personalizados que se adaptan en tiempo real al progreso de cada usuario.</p>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"md:col-span-1 md:row-span-1 glass-card p-8 flex flex-col justify-between bento-item hover:translate-y-[-8px] transition-transform\" data-kid=\"83\">\n                        <div class=\"w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-[var(--primary)] text-2xl\" data-kid=\"84\">\n                            <i class=\"ti ti-repeat\" data-kid=\"85\"></i>\n                        </div>\n                        <div data-kid=\"86\">\n                            <h4 class=\"font-bold text-xl mb-2\" data-kid=\"87\">Check-ins</h4>\n                            <p class=\"text-sm text-[var(--slate-600)] font-dm\" data-kid=\"88\">Automatiza el seguimiento y mantén la constancia.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"md:col-span-1 md:row-span-1 glass-card p-8 flex flex-col justify-between bento-item hover:translate-y-[-8px] transition-transform\" data-kid=\"89\">\n                        <div class=\"w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-[var(--primary)] text-2xl\" data-kid=\"90\">\n                            <i class=\"ti ti-trending-up\" data-kid=\"91\"></i>\n                        </div>\n                        <div data-kid=\"92\">\n                            <h4 class=\"font-bold text-xl mb-2\" data-kid=\"93\">Métricas</h4>\n                            <p class=\"text-sm text-[var(--slate-600)] font-dm\" data-kid=\"94\">Visualiza el crecimiento real con datos precisos.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"md:col-span-2 md:row-span-1 glass-card p-8 flex items-center gap-8 bento-item hover:translate-y-[-8px] transition-transform\" data-kid=\"95\">\n                        <div class=\"w-16 h-16 bg-[var(--primary)]/10 rounded-2xl flex items-center justify-center text-[var(--primary)] text-3xl shrink-0\" data-kid=\"96\">\n                            <i class=\"ti ti-target\" data-kid=\"97\"></i>\n                        </div>\n                        <div data-kid=\"98\">\n                            <h4 class=\"font-bold text-xl mb-2\" data-kid=\"99\">Metas Claras</h4>\n                            <p class=\"text-sm text-[var(--slate-600)] font-dm\" data-kid=\"100\">Ayuda a tus usuarios a enfocarse en lo que importa.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"md:col-span-2 md:row-span-1 glass-card p-8 bg-slate-900 text-white bento-item hover:translate-y-[-8px] transition-transform\" data-kid=\"101\">\n                        <div class=\"flex items-center gap-4 mb-6\" data-kid=\"102\">\n                            <div class=\"flex -space-x-3\" data-kid=\"103\">\n                                <img src=\"https://i.pravatar.cc/100?u=a1\" class=\"w-10 h-10 rounded-full border-2 border-slate-900\" alt=\"Avatar\" decoding=\"async\" loading=\"lazy\" data-kid=\"104\">\n                                <img src=\"https://i.pravatar.cc/100?u=a2\" class=\"w-10 h-10 rounded-full border-2 border-slate-900\" alt=\"Avatar\" decoding=\"async\" loading=\"lazy\" data-kid=\"105\">\n                                <img src=\"https://i.pravatar.cc/100?u=a3\" class=\"w-10 h-10 rounded-full border-2 border-slate-900\" alt=\"Avatar\" decoding=\"async\" loading=\"lazy\" data-kid=\"106\">\n                            </div>\n                            <span class=\"text-xs font-bold text-slate-400 uppercase tracking-widest\" data-kid=\"107\">+500 Mentores Activos</span>\n                        </div>\n                        <p class=\"text-lg font-dm\" data-kid=\"108\">\"ITER cambió la forma en que interactúo con mis alumnos. Es simplemente otro nivel.\"</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"how-it-works\" class=\"py-32 bg-white/30 relative\" data-kid=\"109\">\n            <div class=\"max-w-5xl mx-auto px-6 relative\" data-kid=\"110\">\n                <div class=\"text-center mb-24\" data-kid=\"111\">\n                    <h2 class=\"text-4xl lg:text-5xl font-bold\" data-kid=\"112\">Tu ruta hacia la maestría</h2>\n                    <p class=\"text-[var(--slate-600)] mt-4 font-dm\" data-kid=\"113\">Un proceso fluido diseñado para el éxito de tus clientes.</p>\n                </div>\n\n                <div class=\"relative min-h-[1200px]\" id=\"s-curve-container\" data-kid=\"114\">\n                    \n                    <svg class=\"s-curve-svg\" viewBox=\"0 0 400 1200\" fill=\"none\" preserveAspectRatio=\"none\" data-kid=\"115\">\n                        <path id=\"path-line\" d=\"M200 0 C200 200, 50 200, 50 400 C50 600, 350 600, 350 800 C350 1000, 200 1000, 200 1200\" stroke=\"#E2E8F0\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"116\"></path>\n                        <path id=\"path-progress\" d=\"M200 0 C200 200, 50 200, 50 400 C50 600, 350 600, 350 800 C350 1000, 200 1000, 200 1200\" stroke=\"var(--primary)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"117\"></path>\n                    </svg>\n\n                    \n                    <div class=\"space-y-48\" data-kid=\"118\">\n                        \n                        <div class=\"flex justify-start relative z-10 step-reveal\" data-kid=\"119\">\n                            <div class=\"glass-card p-10 max-w-md bg-white/90 shadow-2xl shadow-slate-200\" data-kid=\"120\">\n                                <div class=\"text-[var(--primary)] font-bold mb-4 uppercase tracking-[0.2em] text-xs\" data-kid=\"121\">Paso 01</div>\n                                <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"122\">Diseño Formativo</h3>\n                                <p class=\"text-slate-600 font-dm leading-relaxed\" data-kid=\"123\">Estructura tus programas con una interfaz intuitiva que facilita el aprendizaje y la retención del conocimiento.</p>\n                            </div>\n                            <div class=\"absolute top-1/2 left-[calc(50%-12px)] -translate-y-1/2 w-6 h-6 bg-[var(--primary)] rounded-full border-4 border-white shadow-xl glow-dot\" data-kid=\"124\"></div>\n                        </div>\n\n                        \n                        <div class=\"flex justify-end relative z-10 step-reveal\" data-kid=\"125\">\n                            <div class=\"glass-card p-10 max-w-md bg-white/90 shadow-2xl shadow-slate-200\" data-kid=\"126\">\n                                <div class=\"text-[var(--primary)] font-bold mb-4 uppercase tracking-[0.2em] text-xs\" data-kid=\"127\">Paso 02</div>\n                                <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"128\">Consolidar Constancia</h3>\n                                <p class=\"text-slate-600 font-dm leading-relaxed\" data-kid=\"129\">Herramientas de gamificación y recordatorios inteligentes que mantienen a tus usuarios motivados día tras día.</p>\n                            </div>\n                            <div class=\"absolute top-1/2 right-[calc(50%-12px)] -translate-y-1/2 w-6 h-6 bg-[var(--primary)] rounded-full border-4 border-white shadow-xl glow-dot\" data-kid=\"130\"></div>\n                        </div>\n\n                        \n                        <div class=\"flex justify-start relative z-10 step-reveal\" data-kid=\"131\">\n                            <div class=\"glass-card p-10 max-w-md bg-white/90 shadow-2xl shadow-slate-200\" data-kid=\"132\">\n                                <div class=\"text-[var(--primary)] font-bold mb-4 uppercase tracking-[0.2em] text-xs\" data-kid=\"133\">Paso 03</div>\n                                <h3 class=\"text-2xl font-bold mb-4\" data-kid=\"134\">Reconocer el Esfuerzo</h3>\n                                <p class=\"text-slate-600 font-dm leading-relaxed\" data-kid=\"135\">Analíticas avanzadas y certificados de progreso para celebrar cada hito alcanzado en la ruta formativa.</p>\n                            </div>\n                            <div class=\"absolute top-1/2 left-[calc(50%-12px)] -translate-y-1/2 w-6 h-6 bg-[var(--primary)] rounded-full border-4 border-white shadow-xl glow-dot\" data-kid=\"136\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 relative px-6\" data-kid=\"137\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"138\">\n                <div class=\"glass-card p-12 lg:p-20 relative overflow-hidden bg-white\" data-kid=\"139\">\n                    <div class=\"absolute top-0 right-0 w-64 h-64 bg-[var(--primary)]/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl\" data-kid=\"140\"></div>\n                    \n                    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-16 text-center lg:text-left\" data-kid=\"141\">\n                        <div class=\"space-y-6 benefit-item\" data-kid=\"142\">\n                            <div class=\"w-16 h-16 bg-pink-50 rounded-2xl flex items-center justify-center text-pink-500 text-3xl mx-auto lg:mx-0\" data-kid=\"143\">\n                                <i class=\"ti ti-heart\" data-kid=\"144\"></i>\n                            </div>\n                            <h4 class=\"text-2xl font-bold\" data-kid=\"145\">Acompañamiento Cercano</h4>\n                            <p class=\"text-[var(--slate-600)] font-dm\" data-kid=\"146\">Siente a tus clientes más cerca que nunca con comunicación bidireccional fluida.</p>\n                        </div>\n                        <div class=\"space-y-6 benefit-item\" data-kid=\"147\">\n                            <div class=\"w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-500 text-3xl mx-auto lg:mx-0\" data-kid=\"148\">\n                                <i class=\"ti ti-target\" data-kid=\"149\"></i>\n                            </div>\n                            <h4 class=\"text-2xl font-bold\" data-kid=\"150\">Metas Claras</h4>\n                            <p class=\"text-[var(--slate-600)] font-dm\" data-kid=\"151\">Objetivos visuales y tangibles que garantizan el cumplimiento de cada programa.</p>\n                        </div>\n                        <div class=\"space-y-6 benefit-item\" data-kid=\"152\">\n                            <div class=\"w-16 h-16 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-500 text-3xl mx-auto lg:mx-0\" data-kid=\"153\">\n                                <i class=\"ti ti-repeat\" data-kid=\"154\"></i>\n                            </div>\n                            <h4 class=\"text-2xl font-bold\" data-kid=\"155\">Mayor Retención</h4>\n                            <p class=\"text-[var(--slate-600)] font-dm\" data-kid=\"156\">Reduce el churn rate gracias a una experiencia de usuario que enamora.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <footer id=\"bottom-overlay\" class=\"bg-[#FAFAFC] rounded-t-[48px] pt-24 pb-12 px-6 border-t border-slate-200\" data-kid=\"157\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"158\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center mb-24\" data-kid=\"159\">\n                <div data-kid=\"160\">\n                    <h2 class=\"text-4xl lg:text-5xl font-bold mb-6\" data-kid=\"161\">¿Listo para crear tu entorno privado?</h2>\n                    <p class=\"text-[var(--slate-600)] text-lg font-dm\" data-kid=\"162\">Únete a Quantic Ecosystem y eleva tu metodología al siguiente nivel.</p>\n                </div>\n                <div class=\"relative\" data-kid=\"163\">\n                    <div class=\"flex p-2 bg-white rounded-full shadow-lg border border-slate-100\" data-kid=\"164\">\n                        <input type=\"email\" placeholder=\"Tu email profesional\" class=\"flex-1 bg-transparent px-6 py-4 outline-none font-dm text-slate-900\" data-kid=\"165\">\n                        <button class=\"bg-[var(--primary)] text-white px-8 py-4 rounded-full font-bold shadow-lg shadow-[var(--primary)]/20 hover:bg-[#6A7CDA] transition-colors whitespace-nowrap cursor-pointer\" data-kid=\"166\">\n                            Crear Entorno Privado\n                        </button>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"flex flex-col md:flex-row justify-between items-center pt-12 border-t border-slate-200 gap-8\" data-kid=\"167\">\n                <div class=\"flex items-center gap-2 font-bold text-xl opacity-60\" data-kid=\"168\">\n                    <i class=\"ti ti-activity\" data-kid=\"169\"></i>\n                    ITER\n                </div>\n                <div class=\"flex items-center gap-8 text-sm font-medium text-slate-400\" data-kid=\"170\">\n                    <a href=\"#\" class=\"hover:text-[var(--slate-950)] transition-colors\" data-kid=\"171\">Privacidad</a>\n                    <a href=\"#\" class=\"hover:text-[var(--slate-950)] transition-colors\" data-kid=\"172\">Términos</a>\n                    <a href=\"#\" class=\"hover:text-[var(--slate-950)] transition-colors\" data-kid=\"173\">Cookies</a>\n                    <a href=\"#\" class=\"hover:text-[var(--slate-950)] transition-colors\" data-kid=\"174\">Quantic Ecosystem</a>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"175\">\n                    <a href=\"#\" class=\"w-10 h-10 flex items-center justify-center rounded-full bg-slate-200/50 hover:bg-slate-200 transition-colors\" data-kid=\"176\">\n                        <i class=\"ti ti-brand-instagram\" data-kid=\"177\"></i>\n                    </a>\n                    <a href=\"#\" class=\"w-10 h-10 flex items-center justify-center rounded-full bg-slate-200/50 hover:bg-slate-200 transition-colors\" data-kid=\"178\">\n                        <i class=\"ti ti-brand-linkedin\" data-kid=\"179\"></i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"text-center mt-12 text-slate-300 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"180\">\n                &copy; 2024 ITER BY QUANTIC. ALL RIGHTS RESERVED.\n            </div>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"181\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"182\"></script>\n<script type=\"module\" data-kid=\"183\">\n    import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n    import Lenis from \"https://esm.sh/lenis@1\";\n\n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance (GSAP)\n    gsap.from(\".hero-item\", {\n        y: 30,\n        autoAlpha: 0,\n        duration: 0.8,\n        stagger: 0.1,\n        ease: \"power3.out\"\n    });\n\n    gsap.from(\".hero-mockup-reveal\", {\n        x: -50,\n        autoAlpha: 0,\n        duration: 1,\n        ease: \"power3.out\"\n    });\n\n    // Pill Nav Scroll Logic (Motion JS)\n    let lastY = 0;\n    scroll(({ y }) => {\n        const diff = y.current - lastY;\n        if (diff > 5 && y.current > 100) {\n            animate(\"#pill-nav\", { y: \"-150%\", opacity: 0 }, { duration: 0.4 });\n        } else if (diff < -5) {\n            animate(\"#pill-nav\", { y: \"0%\", opacity: 1 }, { duration: 0.4 });\n        }\n        lastY = y.current;\n    });\n\n    // Dual Switch Interaction\n    const btnGym = document.getElementById('btn-gym');\n    const btnMentor = document.getElementById('btn-mentor');\n    const indicator = document.getElementById('switch-indicator');\n    const mockupGym = document.getElementById('mockup-gym');\n    const mockupMentor = document.getElementById('mockup-mentor');\n\n    btnGym.addEventListener('click', () => {\n        gsap.to(indicator, { x: 0, duration: 0.4, ease: \"power3.inOut\" });\n        btnGym.classList.add('text-slate-900');\n        btnGym.classList.remove('text-slate-500');\n        btnMentor.classList.remove('text-slate-900');\n        btnMentor.classList.add('text-slate-500');\n        \n        gsap.to(mockupMentor, { autoAlpha: 0, duration: 0.3, onComplete: () => {\n            mockupMentor.classList.add('hidden');\n            mockupGym.classList.remove('hidden');\n            gsap.fromTo(mockupGym, { autoAlpha: 0, scale: 0.95 }, { autoAlpha: 1, scale: 1, duration: 0.4 });\n        }});\n    });\n\n    btnMentor.addEventListener('click', () => {\n        const xVal = btnMentor.offsetLeft - btnGym.offsetLeft;\n        gsap.to(indicator, { x: xVal, duration: 0.4, ease: \"power3.inOut\" });\n        btnMentor.classList.add('text-slate-900');\n        btnMentor.classList.remove('text-slate-500');\n        btnGym.classList.remove('text-slate-900');\n        btnGym.classList.add('text-slate-500');\n\n        gsap.to(mockupGym, { autoAlpha: 0, duration: 0.3, onComplete: () => {\n            mockupGym.classList.add('hidden');\n            mockupMentor.classList.remove('hidden');\n            gsap.fromTo(mockupMentor, { autoAlpha: 0, scale: 0.95 }, { autoAlpha: 1, scale: 1, duration: 0.4 });\n        }});\n    });\n\n    // Bento Grid Reveal\n    gsap.from(\".bento-item\", {\n        scrollTrigger: {\n            trigger: \"#giant-cluster\",\n            start: \"top 80%\",\n        },\n        y: 40,\n        autoAlpha: 0,\n        duration: 0.6,\n        stagger: 0.1,\n        ease: \"power3.out\"\n    });\n\n    // S-Curve Progress\n    const pathProgress = document.getElementById('path-progress');\n    const totalLength = pathProgress.getTotalLength();\n    gsap.set(pathProgress, { strokeDasharray: totalLength, strokeDashoffset: totalLength });\n\n    scroll(({ y }) => {\n        const container = document.getElementById('s-curve-container');\n        const rect = container.getBoundingClientRect();\n        const winHeight = window.innerHeight;\n        \n        let progress = (winHeight - rect.top) / (rect.height + winHeight);\n        progress = Math.min(Math.max(progress, 0), 1);\n        \n        gsap.to(pathProgress, {\n            strokeDashoffset: totalLength * (1 - progress),\n            duration: 0.1,\n            ease: \"none\"\n        });\n    });\n\n    // Step Reveals\n    gsap.utils.toArray(\".step-reveal\").forEach((step, i) => {\n        gsap.from(step, {\n            scrollTrigger: {\n                trigger: step,\n                start: \"top 75%\",\n            },\n            x: i % 2 === 0 ? -40 : 40,\n            autoAlpha: 0,\n            duration: 0.8,\n            ease: \"power3.out\"\n        });\n        \n        gsap.from(step.querySelector('.glow-dot'), {\n            scrollTrigger: {\n                trigger: step,\n                start: \"top 75%\",\n            },\n            scale: 0,\n            duration: 0.5,\n            delay: 0.3,\n            ease: \"back.out(1.7)\"\n        });\n    });\n\n    // Benefits Stagger\n    gsap.from(\".benefit-item\", {\n        scrollTrigger: {\n            trigger: \".benefit-item\",\n            start: \"top 85%\",\n        },\n        y: 30,\n        autoAlpha: 0,\n        duration: 0.6,\n        stagger: 0.15,\n        ease: \"power3.out\"\n    });\n\n    // Footer Drawer Effect\n    gsap.from(\"#bottom-overlay\", {\n        scrollTrigger: {\n            trigger: \"#bottom-overlay\",\n            start: \"top bottom\",\n            end: \"bottom bottom\",\n            scrub: true\n        },\n        yPercent: 20,\n        ease: \"none\"\n    });\n\n</script>\n",
