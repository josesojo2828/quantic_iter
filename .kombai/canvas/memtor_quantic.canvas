      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg: #0B0F19;\n    --mentor-primary: #6366F1;\n    --mentor-secondary: #8B5CF6;\n    --gym-primary: #10B981;\n    --gym-secondary: #06B6D4;\n    --accent: var(--mentor-primary);\n    --accent-secondary: var(--mentor-secondary);\n  }\n\n  body {\n    background-color: var(--bg);\n    color: white;\n    font-family: 'Inter', sans-serif;\n    overflow-x: clip;\n    margin: 0;\n  }\n\n  .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n  /* Aurora Background */\n  .aurora-container {\n    position: fixed;\n    inset: 0;\n    z-index: -10;\n    overflow: hidden;\n  }\n  .aurora-orb {\n    position: absolute;\n    border-radius: 50%;\n    filter: blur(100px);\n    opacity: 0.45;\n  }\n\n  /* Glass Effects */\n  .glass {\n    background: rgba(255, 255, 255, 0.03);\n    backdrop-filter: blur(20px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n  .glass-hover:hover {\n    border-color: rgba(255, 255, 255, 0.15);\n    background: rgba(255, 255, 255, 0.05);\n  }\n\n  /* Custom Range Slider */\n  input[type=range] {\n    -webkit-appearance: none;\n    width: 100%;\n    background: rgba(255, 255, 255, 0.1);\n    height: 8px;\n    border-radius: 999px;\n  }\n  input[type=range]::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    height: 24px;\n    width: 24px;\n    border-radius: 50%;\n    background: var(--accent);\n    cursor: pointer;\n    box-shadow: 0 0 15px var(--accent);\n    border: 3px solid white;\n    margin-top: -8px;\n  }\n  input[type=range]::-webkit-slider-runnable-track {\n    width: 100%;\n    height: 8px;\n    cursor: pointer;\n    border-radius: 999px;\n  }\n\n  .text-glow {\n    text-shadow: 0 0 30px var(--accent);\n  }\n\n  .neon-border {\n    border: 1.5px solid var(--accent);\n    box-shadow: 0 0 12px rgba(99, 102, 241, 0.2), 0 0 36px rgba(99, 102, 241, 0.06);\n  }\n\n  .mask-image-fade {\n    mask-image: linear-gradient(to bottom, black 80%, transparent 100%);\n  }\n</style>\n\n<div id=\"main-wrapper\" class=\"relative\" data-kid=\"1\">\n  \n  <div class=\"aurora-container\" data-kid=\"2\">\n    <div id=\"orb-1\" class=\"aurora-orb w-[600px] h-[600px] bg-[var(--mentor-primary)] top-[-10%] left-[-10%]\" data-kid=\"3\"></div>\n    <div id=\"orb-2\" class=\"aurora-orb w-[800px] h-[800px] bg-[var(--mentor-secondary)] bottom-[-20%] right-[-10%]\" data-kid=\"4\"></div>\n    <div id=\"orb-3\" class=\"aurora-orb w-[400px] h-[400px] bg-[var(--mentor-primary)] top-[40%] right-[10%] opacity-20\" data-kid=\"5\"></div>\n  </div>\n\n  \n  <nav id=\"pill-nav\" class=\"fixed top-6 left-1/2 -translate-x-1/2 glass px-6 py-3 rounded-full flex items-center gap-8 z-50\" data-kid=\"6\">\n    <div class=\"flex items-center gap-2\" data-kid=\"7\">\n      <div class=\"w-8 h-8 rounded-lg bg-[var(--accent)] flex items-center justify-center font-bold text-white shadow-lg\" data-kid=\"8\">MQ</div>\n      <span class=\"font-heading font-bold tracking-tight\" data-kid=\"9\">Memtor Quantic</span>\n    </div>\n    <div class=\"hidden md:flex items-center gap-6 text-sm font-medium text-white/60\" data-kid=\"10\">\n      <a href=\"#features\" class=\"hover:text-white transition-colors\" data-kid=\"11\">Features</a>\n      <a href=\"#pricing\" class=\"hover:text-white transition-colors\" data-kid=\"12\">Pricing</a>\n      <a href=\"#ecosystem\" class=\"hover:text-white transition-colors\" data-kid=\"13\">Ecosystem</a>\n    </div>\n    <button class=\"bg-white text-black px-5 py-2 rounded-full text-xs font-bold hover:scale-105 transition-transform\" data-kid=\"14\">Get Started</button>\n  </nav>\n\n  \n  <section class=\"relative pt-32 pb-20 px-6 min-h-screen flex flex-col items-center\" data-kid=\"15\">\n    <div class=\"max-w-5xl w-full text-center\" data-kid=\"16\">\n      \n      <div id=\"theme-toggle\" class=\"inline-flex glass p-1.5 rounded-full mb-12 relative overflow-hidden\" data-kid=\"17\">\n        <div id=\"toggle-bg\" class=\"absolute top-1.5 bottom-1.5 left-1.5 w-[calc(50%-6px)] bg-[var(--accent)] rounded-full shadow-lg z-0\" data-kid=\"18\"></div>\n        <button onclick=\"switchMode('mentor')\" id=\"btn-mentor\" class=\"relative z-10 px-8 py-2.5 text-sm font-bold transition-colors text-white\" data-kid=\"19\">Mentor Mode</button>\n        <button onclick=\"switchMode('gym')\" id=\"btn-gym\" class=\"relative z-10 px-8 py-2.5 text-sm font-bold transition-colors text-white/50\" data-kid=\"20\">Gym Mode</button>\n      </div>\n\n      <h1 id=\"hero-title\" class=\"font-heading text-6xl md:text-8xl font-extrabold leading-[1.1] mb-8 tracking-tighter\" data-kid=\"21\">\n        Architecting <br data-kid=\"22\">\n        <span class=\"text-[var(--accent)] transition-colors duration-500\" data-kid=\"23\">Elite Performance.</span>\n      </h1>\n      \n      <p id=\"hero-sub\" class=\"text-xl md:text-2xl text-white/60 max-w-3xl mx-auto mb-12 font-light leading-relaxed\" data-kid=\"24\">\n        The dual-ecosystem intelligence platform designed for world-class coaches and high-volume fitness labs. One engine, two specialized worlds.\n      </p>\n\n      <div class=\"flex flex-wrap justify-center gap-4 mb-20\" data-kid=\"25\">\n        <button class=\"px-10 py-4 bg-[var(--accent)] rounded-full font-bold text-lg shadow-[0_0_40px_rgba(99,102,241,0.3)] hover:scale-105 transition-all\" data-kid=\"26\">Launch Dashboard</button>\n        <button class=\"px-10 py-4 glass rounded-full font-bold text-lg hover:bg-white/10 transition-all\" data-kid=\"27\">View Demo</button>\n      </div>\n    </div>\n\n    \n    <div id=\"dashboard-preview\" class=\"w-full max-w-6xl mx-auto glass rounded-2xl overflow-hidden shadow-2xl border-white/20 relative group scale-[1.02]\" data-kid=\"28\">\n      <div class=\"h-10 border-b border-white/10 bg-white/5 flex items-center px-4 gap-2\" data-kid=\"29\">\n        <div class=\"flex gap-1.5\" data-kid=\"30\">\n          <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"31\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-yellow-500/50\" data-kid=\"32\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-green-500/50\" data-kid=\"33\"></div>\n        </div>\n        <div class=\"mx-auto w-1/2 h-5 bg-white/5 rounded-md text-[10px] flex items-center justify-center text-white/20 font-mono\" data-kid=\"34\">quantic.memtor.io/dashboard/v2</div>\n      </div>\n      \n      \n      <div class=\"flex h-[600px] bg-[#0B0F19]\" data-kid=\"35\">\n        \n        <div class=\"w-16 border-r border-white/5 flex flex-col items-center py-6 gap-6 bg-black/20\" data-kid=\"36\">\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--accent)]/20 flex items-center justify-center text-[var(--accent)]\" data-kid=\"37\"><i class=\"ti ti-layout-dashboard text-xl\" data-kid=\"38\"></i></div>\n          <div class=\"w-10 h-10 rounded-xl hover:bg-white/5 flex items-center justify-center text-white/40\" data-kid=\"39\"><i class=\"ti ti-users text-xl\" data-kid=\"40\"></i></div>\n          <div class=\"w-10 h-10 rounded-xl hover:bg-white/5 flex items-center justify-center text-white/40\" data-kid=\"41\"><i class=\"ti ti-calendar-event text-xl\" data-kid=\"42\"></i></div>\n          <div class=\"mt-auto w-10 h-10 rounded-full bg-white/5 flex items-center justify-center overflow-hidden\" data-kid=\"43\"><img src=\"https://i.pravatar.cc/100?u=mentor\" alt=\"User\" data-kid=\"44\"></div>\n        </div>\n        \n        <div class=\"w-64 border-r border-white/5 p-6 hidden md:block\" data-kid=\"45\">\n          <div class=\"text-[10px] font-bold text-white/30 uppercase tracking-widest mb-6\" data-kid=\"46\">Main Command</div>\n          <div class=\"space-y-4\" data-kid=\"47\">\n            <div class=\"p-3 glass rounded-xl text-sm font-medium flex items-center gap-3\" data-kid=\"48\"><i class=\"ti ti-chart-dots text-[var(--accent)]\" data-kid=\"49\"></i> Neural Insights</div>\n            <div class=\"p-3 hover:bg-white/5 rounded-xl text-sm font-medium flex items-center gap-3 text-white/50\" data-kid=\"50\"><i class=\"ti ti-file-text\" data-kid=\"51\"></i> Curriculum Builder</div>\n            <div class=\"p-3 hover:bg-white/5 rounded-xl text-sm font-medium flex items-center gap-3 text-white/50\" data-kid=\"52\"><i class=\"ti ti-message-2\" data-kid=\"53\"></i> Client Connect</div>\n          </div>\n        </div>\n        \n        <div class=\"flex-1 p-8 overflow-y-auto\" data-kid=\"54\">\n          <div class=\"flex justify-between items-end mb-8\" data-kid=\"55\">\n            <div data-kid=\"56\">\n              <h3 id=\"dash-title\" class=\"text-2xl font-bold font-heading\" data-kid=\"57\">Morning Overview</h3>\n              <p class=\"text-white/40 text-sm\" data-kid=\"58\">Welcome back, Strategist.</p>\n            </div>\n            <div class=\"flex gap-2\" data-kid=\"59\">\n              <span class=\"px-3 py-1 bg-green-500/10 text-green-400 text-[10px] font-bold rounded-full border border-green-500/20\" data-kid=\"60\">SYSTEMS NOMINAL</span>\n            </div>\n          </div>\n\n          <div class=\"grid grid-cols-3 gap-6\" data-kid=\"61\">\n            \n            <div class=\"col-span-2 glass p-6 rounded-2xl h-64 flex flex-col justify-between\" data-kid=\"62\">\n              <div class=\"flex justify-between items-center\" data-kid=\"63\">\n                <span class=\"text-sm font-bold opacity-60\" data-kid=\"64\">Client Engagement Velocity</span>\n                <i class=\"ti ti-dots-vertical\" data-kid=\"65\"></i>\n              </div>\n              <div id=\"mock-chart\" class=\"h-32 flex items-end gap-3 px-2\" data-kid=\"66\">\n                \n                <div class=\"flex-1 bg-[var(--accent)]/10 rounded-t h-[35%] transition-all duration-500\" data-kid=\"67\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/30 rounded-t h-[55%] transition-all duration-500\" data-kid=\"68\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/20 rounded-t h-[45%] transition-all duration-500\" data-kid=\"69\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/80 rounded-t h-[85%] transition-all duration-500 shadow-[0_0_20px_var(--accent)]\" data-kid=\"70\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/50 rounded-t h-[65%] transition-all duration-500\" data-kid=\"71\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/20 rounded-t h-[40%] transition-all duration-500\" data-kid=\"72\"></div>\n                <div class=\"flex-1 bg-[var(--accent)]/60 rounded-t h-[75%] transition-all duration-500\" data-kid=\"73\"></div>\n              </div>\n            </div>\n            <div class=\"col-span-1 glass p-6 rounded-2xl flex flex-col gap-4\" data-kid=\"74\">\n              <span class=\"text-sm font-bold opacity-60\" data-kid=\"75\">Recent Milestones</span>\n              <div class=\"space-y-4\" data-kid=\"76\">\n                <div class=\"flex gap-3 items-center\" data-kid=\"77\">\n                  <div class=\"w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 text-xs\" data-kid=\"78\"><i class=\"ti ti-check\" data-kid=\"79\"></i></div>\n                  <div class=\"text-xs\" data-kid=\"80\">John D. completed Week 4</div>\n                </div>\n                <div class=\"flex gap-3 items-center\" data-kid=\"81\">\n                  <div class=\"w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 text-xs\" data-kid=\"82\"><i class=\"ti ti-plus\" data-kid=\"83\"></i></div>\n                  <div class=\"text-xs\" data-kid=\"84\">New Client Onboarding</div>\n                </div>\n                <div class=\"flex gap-3 items-center\" data-kid=\"85\">\n                  <div class=\"w-8 h-8 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-400 text-xs\" data-kid=\"86\"><i class=\"ti ti-star\" data-kid=\"87\"></i></div>\n                  <div class=\"text-xs\" data-kid=\"88\">Record monthly retention</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"features\" class=\"py-32 px-6\" data-kid=\"89\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"90\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 grid-rows-2 gap-6 h-auto md:h-[800px]\" data-kid=\"91\">\n        \n        <div class=\"md:col-span-2 md:row-span-2 glass rounded-[2.5rem] p-12 flex flex-col justify-between overflow-hidden relative group reveal-up\" data-kid=\"92\">\n           <div class=\"absolute -right-20 -bottom-20 w-96 h-96 bg-[var(--accent)]/10 blur-[100px] group-hover:opacity-100 opacity-50 transition-opacity\" data-kid=\"93\"></div>\n           <div data-kid=\"94\">\n             <div class=\"w-16 h-16 glass rounded-2xl flex items-center justify-center mb-8 border-white/20\" data-kid=\"95\">\n               <i class=\"ti ti-brain text-[var(--accent)] text-3xl\" data-kid=\"96\"></i>\n             </div>\n             <h3 class=\"text-4xl font-extrabold font-heading mb-6\" data-kid=\"97\">Neural Insights Engine</h3>\n             <p class=\"text-xl text-white/50 leading-relaxed\" data-kid=\"98\">\n               More than data—it's predictive intelligence. Anticipate client plateauing before it happens with our proprietary quantum analysis loops.\n             </p>\n           </div>\n           <div class=\"mt-12 glass p-6 rounded-3xl border-white/5 bg-white/[0.02]\" data-kid=\"99\">\n              <div class=\"flex items-center justify-between mb-4\" data-kid=\"100\">\n                <span class=\"text-xs font-bold uppercase tracking-tighter opacity-40\" data-kid=\"101\">Client Predictive Model</span>\n                <span class=\"text-[var(--accent)] font-mono text-xs\" data-kid=\"102\">V2.4 Active</span>\n              </div>\n              <div class=\"space-y-3\" data-kid=\"103\">\n                <div class=\"h-2 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"104\">\n                  <div class=\"h-full bg-[var(--accent)] w-[75%] rounded-full shadow-[0_0_10px_var(--accent)]\" data-kid=\"105\"></div>\n                </div>\n                <div class=\"h-2 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"106\">\n                  <div class=\"h-full bg-[var(--accent)] w-[40%] rounded-full opacity-50\" data-kid=\"107\"></div>\n                </div>\n              </div>\n           </div>\n        </div>\n\n        \n        <div class=\"md:col-span-2 glass rounded-[2.5rem] p-10 flex items-center gap-10 reveal-up\" data-kid=\"108\">\n           <div class=\"flex-1\" data-kid=\"109\">\n             <h4 class=\"text-2xl font-bold font-heading mb-4\" data-kid=\"110\">SmartFlow CRM</h4>\n             <p class=\"text-white/50\" data-kid=\"111\">Node-based automation that speaks like you do. Build custom onboarding chains in minutes.</p>\n           </div>\n           <div id=\"flow-chain\" class=\"flex items-center gap-4\" data-kid=\"112\">\n             <div class=\"w-12 h-12 glass rounded-full flex items-center justify-center border-[var(--accent)]/30\" data-kid=\"113\"><i class=\"ti ti-mail text-[var(--accent)]\" data-kid=\"114\"></i></div>\n             <div class=\"w-6 h-px bg-white/10\" data-kid=\"115\"></div>\n             <div class=\"w-12 h-12 bg-[var(--accent)] rounded-full flex items-center justify-center shadow-lg\" data-kid=\"116\"><i class=\"ti ti-check\" data-kid=\"117\"></i></div>\n           </div>\n        </div>\n\n        \n        <div class=\"glass rounded-[2.5rem] p-10 flex flex-col justify-center text-center reveal-up\" data-kid=\"118\">\n           <div class=\"text-4xl font-extrabold font-heading mb-2 text-[var(--accent)]\" data-kid=\"119\">0%</div>\n           <div class=\"text-xs uppercase tracking-widest opacity-40 font-bold\" data-kid=\"120\">Transaction Fees</div>\n           <p class=\"mt-4 text-xs text-white/50\" data-kid=\"121\">Keep 100% of your gains. We only grow when you scale.</p>\n        </div>\n\n        \n        <div class=\"glass rounded-[2.5rem] p-10 flex flex-col justify-between reveal-up\" data-kid=\"122\">\n           <div class=\"flex gap-2\" data-kid=\"123\">\n             <div class=\"w-6 h-6 rounded-full bg-[var(--mentor-primary)]\" data-kid=\"124\"></div>\n             <div class=\"w-6 h-6 rounded-full bg-[var(--mentor-secondary)]\" data-kid=\"125\"></div>\n             <div class=\"w-6 h-6 rounded-full bg-[var(--gym-primary)]\" data-kid=\"126\"></div>\n           </div>\n           <div data-kid=\"127\">\n             <h4 class=\"text-xl font-bold font-heading\" data-kid=\"128\">Brand Forge</h4>\n             <p class=\"text-sm text-white/50 mt-2\" data-kid=\"129\">Fully white-labeled. Your brand, powered by our tech.</p>\n           </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"pricing\" class=\"py-32 px-6\" data-kid=\"130\">\n    <div class=\"max-w-4xl mx-auto glass rounded-[3rem] p-12 md:p-20 relative overflow-hidden\" data-kid=\"131\">\n       <div class=\"absolute top-0 right-0 w-64 h-64 bg-[var(--accent)] opacity-5 blur-[80px]\" data-kid=\"132\"></div>\n       \n       <div class=\"text-center mb-16\" data-kid=\"133\">\n         <h2 class=\"text-4xl md:text-5xl font-extrabold font-heading mb-4\" data-kid=\"134\">Hyper-Scaling Logic</h2>\n         <p class=\"text-white/50\" data-kid=\"135\">Predict your growth trajectory with our dynamic calculator.</p>\n       </div>\n\n       <div class=\"mb-20 px-4\" data-kid=\"136\">\n         <div class=\"flex justify-between mb-6 text-sm font-bold opacity-40 uppercase tracking-widest\" data-kid=\"137\">\n           <span data-kid=\"138\">Small Practice (10)</span>\n           <span data-kid=\"139\">Global Empire (5000)</span>\n         </div>\n         <div class=\"relative group\" data-kid=\"140\">\n           <input type=\"range\" id=\"client-slider\" min=\"10\" max=\"5000\" value=\"250\" class=\"cursor-pointer\" data-kid=\"141\">\n           <div id=\"slider-glow\" class=\"absolute inset-0 pointer-events-none blur-lg opacity-20 bg-[var(--accent)] rounded-full\" data-kid=\"142\"></div>\n         </div>\n         <div id=\"slider-val\" class=\"mt-8 text-center text-2xl font-bold font-heading text-[var(--accent)]\" data-kid=\"143\">250 Clients</div>\n       </div>\n\n       <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-white/10\" data-kid=\"144\">\n          <div class=\"text-center md:text-left\" data-kid=\"145\">\n            <div class=\"text-xs uppercase tracking-widest opacity-40 font-bold mb-2\" data-kid=\"146\">Platform Investment</div>\n            <div id=\"price-display\" class=\"text-6xl font-extrabold font-heading\" data-kid=\"147\">$149<span class=\"text-lg opacity-20\" data-kid=\"148\">/mo</span></div>\n          </div>\n          <div class=\"text-center md:text-right\" data-kid=\"149\">\n            <div class=\"text-xs uppercase tracking-widest opacity-40 font-bold mb-2\" data-kid=\"150\">Projected Annual Revenue</div>\n            <div id=\"rev-display\" class=\"text-6xl font-extrabold font-heading text-[var(--accent)]\" data-kid=\"151\">$450k</div>\n          </div>\n       </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"pt-20 pb-10 px-6 border-t border-white/5\" data-kid=\"152\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"153\">\n      <div class=\"glass rounded-[3rem] p-12 md:p-20 flex flex-col md:flex-row items-center justify-between gap-12 mb-20 relative overflow-hidden\" data-kid=\"154\">\n        <div id=\"footer-glow\" class=\"absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,var(--accent),transparent_50%)] opacity-10\" data-kid=\"155\"></div>\n        <div class=\"relative z-10 max-w-xl text-center md:text-left\" data-kid=\"156\">\n          <h2 class=\"text-4xl md:text-5xl font-extrabold font-heading mb-6\" data-kid=\"157\">Ready to transcend?</h2>\n          <p class=\"text-white/50 text-lg\" data-kid=\"158\">Join 2,500+ elite coaches and gym owners scaling with Quantic intelligence.</p>\n        </div>\n        <div class=\"relative z-10 w-full md:w-auto\" data-kid=\"159\">\n          <div class=\"flex p-1 bg-white/5 rounded-full border border-white/10 glass\" data-kid=\"160\">\n            <input type=\"email\" placeholder=\"your@email.com\" class=\"bg-transparent border-none outline-hidden px-6 py-4 flex-1 text-white placeholder:text-white/20 min-w-[200px]\" data-kid=\"161\">\n            <button class=\"bg-white text-black px-8 py-4 rounded-full font-bold hover:scale-105 transition-all\" data-kid=\"162\">Get Invitation</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-2 md:grid-cols-4 gap-12 mb-20 text-sm\" data-kid=\"163\">\n        <div class=\"space-y-4\" data-kid=\"164\">\n          <div class=\"font-bold font-heading text-lg\" data-kid=\"165\">Memtor Quantic</div>\n          <p class=\"text-white/40\" data-kid=\"166\">The frontier of human optimization through digital systems.</p>\n        </div>\n        <div class=\"space-y-4\" data-kid=\"167\">\n          <div class=\"font-bold opacity-30 uppercase tracking-widest text-xs\" data-kid=\"168\">Product</div>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"169\">Mentor Platform</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"170\">Gym OS</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"171\">Neural API</a>\n        </div>\n        <div class=\"space-y-4\" data-kid=\"172\">\n          <div class=\"font-bold opacity-30 uppercase tracking-widest text-xs\" data-kid=\"173\">Resources</div>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"174\">Intelligence Hub</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"175\">Case Studies</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"176\">Docs</a>\n        </div>\n        <div class=\"space-y-4\" data-kid=\"177\">\n          <div class=\"font-bold opacity-30 uppercase tracking-widest text-xs\" data-kid=\"178\">Company</div>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"179\">About Us</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"180\">Careers</a>\n          <a href=\"#\" class=\"block text-white/60 hover:text-white\" data-kid=\"181\">Contact</a>\n        </div>\n      </div>\n      <div class=\"text-center text-white/20 text-xs border-t border-white/5 pt-10\" data-kid=\"182\">\n        &copy; 2024 Memtor Quantic Inc. All rights reserved. Quantum Security Encrypted.\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"183\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"184\"></script>\n<script type=\"module\" data-kid=\"185\">\n  import { animate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize GSAP reveals\n  gsap.utils.toArray('.reveal-up').forEach(el => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: 'top 85%',\n        toggleActions: 'play none none none'\n      },\n      y: 40,\n      opacity: 0,\n      duration: 1,\n      ease: 'power4.out'\n    });\n  });\n\n  // Hero entrance\n  const heroTimeline = gsap.timeline();\n  heroTimeline.from('#hero-title', {\n    y: 100,\n    opacity: 0,\n    duration: 1.2,\n    ease: 'power4.out'\n  }).from('#hero-sub', {\n    y: 30,\n    opacity: 0,\n    duration: 1,\n    ease: 'power4.out'\n  }, '-=0.8').from('#dashboard-preview', {\n    y: 150,\n    opacity: 0,\n    duration: 1.5,\n    ease: 'expo.out'\n  }, '-=1');\n\n  // Background color shift on scroll\n  scroll(\n    animate(\".aurora-container\", { opacity: [0.45, 0.7, 0.45] }),\n    { offset: [\"start start\", \"end end\"] }\n  );\n\n  // Theme Switcher Logic\n  window.currentMode = 'mentor';\n  window.switchMode = function(mode) {\n    if (mode === window.currentMode) return;\n    window.currentMode = mode;\n    \n    const root = document.documentElement;\n    const orb1 = document.getElementById('orb-1');\n    const orb2 = document.getElementById('orb-2');\n    const orb3 = document.getElementById('orb-3');\n    const toggleBg = document.getElementById('toggle-bg');\n    const btnMentor = document.getElementById('btn-mentor');\n    const btnGym = document.getElementById('btn-gym');\n    \n    if (mode === 'mentor') {\n      gsap.to(orb1, { backgroundColor: '#6366F1', duration: 1 });\n      gsap.to(orb2, { backgroundColor: '#8B5CF6', duration: 1 });\n      gsap.to(orb3, { backgroundColor: '#6366F1', duration: 1 });\n      gsap.to(toggleBg, { x: 0, backgroundColor: '#6366F1', duration: 0.4, ease: 'back.out' });\n      gsap.to(':root', { '--accent': '#6366F1', '--accent-secondary': '#8B5CF6', duration: 0.5 });\n      btnMentor.classList.remove('text-white/50');\n      btnMentor.classList.add('text-white');\n      btnGym.classList.add('text-white/50');\n      btnGym.classList.remove('text-white');\n      \n      document.getElementById('dash-title').innerText = \"Morning Overview\";\n      \n      // Update chart bars for visual flair\n      gsap.utils.toArray('#mock-chart div').forEach((bar, i) => {\n        gsap.to(bar, { height: `${[35, 55, 45, 85, 65, 40, 75][i]}%`, duration: 0.6, ease: 'power2.out' });\n      });\n\n      updatePricing(document.getElementById('client-slider').value);\n    } else {\n      gsap.to(orb1, { backgroundColor: '#10B981', duration: 1 });\n      gsap.to(orb2, { backgroundColor: '#06B6D4', duration: 1 });\n      gsap.to(orb3, { backgroundColor: '#10B981', duration: 1 });\n      gsap.to(toggleBg, { x: '100%', backgroundColor: '#10B981', duration: 0.4, ease: 'back.out' });\n      gsap.to(':root', { '--accent': '#10B981', '--accent-secondary': '#06B6D4', duration: 0.5 });\n      btnGym.classList.remove('text-white/50');\n      btnGym.classList.add('text-white');\n      btnMentor.classList.add('text-white/50');\n      btnMentor.classList.remove('text-white');\n\n      document.getElementById('dash-title').innerText = \"Facility Performance\";\n\n      // Update chart bars for visual flair\n      gsap.utils.toArray('#mock-chart div').forEach((bar, i) => {\n        gsap.to(bar, { height: `${[70, 40, 90, 50, 80, 60, 45][i]}%`, duration: 0.6, ease: 'power2.out' });\n      });\n\n      updatePricing(document.getElementById('client-slider').value);\n    }\n  };\n\n  // Pricing Logic\n  const slider = document.getElementById('client-slider');\n  const priceDisplay = document.getElementById('price-display');\n  const revDisplay = document.getElementById('rev-display');\n  const sliderVal = document.getElementById('slider-val');\n\n  function updatePricing(val) {\n    sliderVal.innerText = `${val} Clients`;\n    const price = Math.floor(val * 0.5) + 49;\n    const revenue = (val * 150 * 12) / 1000;\n    \n    priceDisplay.innerHTML = `$${price}<span class=\"text-lg opacity-20\">/mo</span>`;\n    revDisplay.innerText = `$${revenue.toFixed(0)}k`;\n  }\n\n  slider.oninput = function() {\n    updatePricing(this.value);\n  };\n</script>\n",
