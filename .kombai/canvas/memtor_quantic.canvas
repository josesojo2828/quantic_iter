        "config": {}
      },
      "html": "\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n\n  :root {\n    --periwinkle: #7A8CEB;\n    --bg-main: #EDF0F5;\n    --card-bg: #FFFFFF;\n    --text-slate: #1E293B;\n    --soft-rose: #FFE4E6;\n    --soft-yellow: #FEF3C7;\n  }\n\n  body {\n    background-color: var(--bg-main);\n    color: var(--text-slate);\n    font-family: 'Plus_Jakarta_Sans', sans-serif;\n    overflow-x: clip;\n  }\n\n  .font-ibm { font-family: 'IBM+Plex+Sans', sans-serif; }\n\n  .crystalline-grid {\n    background-image: radial-gradient(circle at 2px 2px, rgba(122, 140, 235, 0.05) 1px, transparent 0);\n    background-size: 40px 40px;\n  }\n\n  .glass-card {\n    background: rgba(255, 255, 255, 0.8);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.5);\n    border-radius: 32px;\n    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.03);\n  }\n\n  .floating-footer-pill {\n    position: fixed;\n    bottom: 32px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 1000;\n  }\n\n  [data-scroll] {\n    opacity: 0;\n    transform: translateY(30px);\n    transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);\n  }\n\n  [data-scroll].is-inview {\n    opacity: 1;\n    transform: translateY(0);\n  }\n</style>\n\n<div class=\"crystalline-grid min-h-screen\" data-kid=\"2\">\n  \n  \n  <header id=\"main-header\" class=\"fixed top-0 left-0 w-full z-[100] px-12 py-6 flex justify-between items-center transition-all duration-300\" data-kid=\"3\">\n    <div class=\"flex items-center gap-2\" data-kid=\"4\">\n      <div class=\"w-10 h-10 bg-[var(--periwinkle)] rounded-xl flex items-center justify-center text-white font-bold text-xl\" data-kid=\"5\">I</div>\n      <span class=\"text-2xl font-extrabold tracking-tight\" data-kid=\"6\">ITER</span>\n    </div>\n    \n    <nav class=\"hidden md:flex items-center gap-10\" data-kid=\"7\">\n      <a href=\"#\" class=\"font-semibold text-[var(--text-slate)]/60 hover:text-[var(--periwinkle)] transition-colors\" data-kid=\"8\">Producto</a>\n      <a href=\"#\" class=\"font-semibold text-[var(--text-slate)]/60 hover:text-[var(--periwinkle)] transition-colors\" data-kid=\"9\">Casos</a>\n      <a href=\"#\" class=\"font-semibold text-[var(--text-slate)]/60 hover:text-[var(--periwinkle)] transition-colors\" data-kid=\"10\">Precios</a>\n    </nav>\n\n    <div class=\"flex items-center gap-4\" data-kid=\"11\">\n      <button class=\"px-6 py-3 bg-white rounded-full font-bold shadow-sm hover:shadow-md transition-all text-sm\" data-kid=\"12\">Acceso Mentor</button>\n    </div>\n  </header>\n\n  \n  <section class=\"relative pt-44 pb-32 px-12 max-w-7xl mx-auto flex items-center gap-16\" data-kid=\"13\">\n    <div class=\"w-[55%] relative z-20\" data-kid=\"14\">\n      <div data-scroll data-kid=\"15\">\n        <h1 class=\"text-7xl font-extrabold leading-[1.1] mb-8\" data-kid=\"16\">\n          La evolución del <br data-kid=\"17\">\n          <span class=\"text-[var(--periwinkle)]\" data-kid=\"18\">espacio deportivo.</span>\n        </h1>\n        <p class=\"text-xl text-[var(--text-slate)]/70 max-w-lg mb-12\" data-kid=\"19\">\n          Gestiona tu centro con la precisión de un cristal y la calidez de un mentor. Una plataforma diseñada para el crecimiento humano.\n        </p>\n\n        \n        <div class=\"relative w-full max-w-md group\" data-kid=\"20\">\n          <div class=\"flex gap-2 absolute -top-11 left-6 z-0\" data-kid=\"21\">\n            <button id=\"tab-gym\" class=\"tab-trigger active px-8 py-3 bg-white rounded-t-[24px] font-bold text-[var(--periwinkle)] border-b-2 border-white transition-all\" data-kid=\"22\">Gimnasios</button>\n            <button id=\"tab-academy\" class=\"tab-trigger px-8 py-3 bg-white/40 backdrop-blur-sm rounded-t-[24px] font-bold text-[var(--text-slate)]/50 hover:bg-white/60 transition-all\" data-kid=\"23\">Academias</button>\n          </div>\n          <div class=\"relative z-10 bg-white p-8 rounded-[32px] rounded-tl-none shadow-[0_30px_60px_-15px_rgba(0,0,0,0.05)] border border-white flex items-center justify-between gap-6\" data-kid=\"24\">\n            <div class=\"space-y-3 flex-1\" data-kid=\"25\">\n              <div class=\"h-2 w-20 bg-[var(--periwinkle)]/20 rounded-full\" data-kid=\"26\"></div>\n              <p class=\"text-sm font-medium text-[var(--text-slate)]/60\" data-kid=\"27\">Configura tu ecosistema en menos de 5 minutos.</p>\n            </div>\n            <button class=\"px-8 py-4 bg-[var(--periwinkle)] text-white rounded-2xl font-bold shadow-lg shadow-[var(--periwinkle)]/30 hover:scale-105 active:scale-95 transition-transform\" data-kid=\"28\">\n              Empezar\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"w-[50%] relative\" data-kid=\"29\">\n      <div id=\"hero-mockup\" class=\"bg-white p-10 rounded-[40px] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.1)] border border-white relative z-10\" data-kid=\"30\">\n        <div class=\"flex justify-between items-center mb-10\" data-kid=\"31\">\n          <div data-kid=\"32\">\n            <p class=\"text-xs font-bold text-[var(--text-slate)]/30 uppercase tracking-widest mb-1\" data-kid=\"33\">Métrica de Impacto</p>\n            <h3 class=\"text-4xl font-black text-[var(--text-slate)]\" data-kid=\"34\">+24.8% <span class=\"text-sm font-medium text-emerald-500 ml-2\" data-kid=\"35\">↑ mes anterior</span></h3>\n          </div>\n          <div class=\"flex -space-x-3\" data-kid=\"36\">\n            <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-10 h-10 rounded-full border-2 border-white\" data-kid=\"37\">\n            <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-10 h-10 rounded-full border-2 border-white\" data-kid=\"38\">\n            <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-10 h-10 rounded-full border-2 border-white\" data-kid=\"39\">\n          </div>\n        </div>\n        \n        <div class=\"flex items-end gap-3 h-56 mb-8\" data-kid=\"40\">\n          <div class=\"flex-1 bg-[var(--bg-main)] rounded-t-2xl h-[40%]\" data-kid=\"41\"></div>\n          <div class=\"flex-1 bg-[var(--bg-main)] rounded-t-2xl h-[65%]\" data-kid=\"42\"></div>\n          <div class=\"flex-1 bg-[var(--bg-main)] rounded-t-2xl h-[45%]\" data-kid=\"43\"></div>\n          <div class=\"flex-1 bg-[var(--periwinkle)] rounded-t-2xl h-[92%] relative\" data-kid=\"44\">\n             <div class=\"absolute -top-12 left-1/2 -translate-x-1/2 bg-[var(--text-slate)] text-white text-[10px] font-bold px-3 py-1.5 rounded-lg\" data-kid=\"45\">98.6%</div>\n          </div>\n          <div class=\"flex-1 bg-[var(--bg-main)] rounded-t-2xl h-[60%]\" data-kid=\"46\"></div>\n          <div class=\"flex-1 bg-[var(--bg-main)] rounded-t-2xl h-[75%]\" data-kid=\"47\"></div>\n        </div>\n\n        <div class=\"grid grid-cols-2 gap-4\" data-kid=\"48\">\n          <div class=\"p-5 bg-[var(--bg-main)] rounded-3xl flex items-center gap-4\" data-kid=\"49\">\n            <div class=\"w-10 h-10 bg-white rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"50\">🔥</div>\n            <div data-kid=\"51\">\n              <p class=\"text-[10px] font-bold text-[var(--text-slate)]/40 uppercase\" data-kid=\"52\">Racha</p>\n              <p class=\"font-bold\" data-kid=\"53\">12 Días</p>\n            </div>\n          </div>\n          <div class=\"p-5 bg-[var(--periwinkle)]/10 rounded-3xl flex items-center gap-4 border border-[var(--periwinkle)]/20\" data-kid=\"54\">\n            <div class=\"w-10 h-10 bg-white rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"55\">✨</div>\n            <div data-kid=\"56\">\n              <p class=\"text-[10px] font-bold text-[var(--periwinkle)] uppercase\" data-kid=\"57\">Estatus</p>\n              <p class=\"font-bold text-[var(--periwinkle)]\" data-kid=\"58\">Premium</p>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"absolute -bottom-10 -right-10 w-64 h-64 bg-[var(--periwinkle)]/20 blur-[100px] -z-10 rounded-full\" data-kid=\"59\"></div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 max-w-7xl mx-auto\" data-kid=\"60\">\n    <div class=\"mb-20 text-center\" data-scroll data-kid=\"61\">\n      <span class=\"px-4 py-2 bg-[var(--periwinkle)]/10 text-[var(--periwinkle)] rounded-full text-xs font-bold uppercase tracking-widest\" data-kid=\"62\">Adaptabilidad</span>\n      <h2 class=\"text-5xl font-extrabold mt-6\" data-kid=\"63\">Diseñado para cada <span class=\"text-[var(--periwinkle)]\" data-kid=\"64\">disciplina.</span></h2>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10 items-start\" data-kid=\"65\">\n      <div class=\"space-y-10 md:mt-16\" data-kid=\"66\">\n        \n        <div class=\"use-case-card relative bg-white p-12 rounded-[32px] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.03)] border border-white overflow-hidden group\" data-kid=\"67\">\n          <span class=\"absolute -bottom-10 -right-4 text-[160px] font-black text-[var(--periwinkle)]/5 z-0 select-none pointer-events-none\" data-kid=\"68\">01</span>\n          <div class=\"relative z-10\" data-kid=\"69\">\n            <div class=\"w-20 h-20 mb-8 overflow-hidden rounded-2xl\" data-kid=\"70\">\n              <img src=\"https://images.unsplash.com/photo-1710244182004-1c708b3f146d?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"71\">\n            </div>\n            <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"72\">Fitness & Gym</h4>\n            <p class=\"text-[var(--text-slate)]/60 text-lg leading-relaxed\" data-kid=\"73\">Automatización de accesos, gestión de cuotas recurrentes y analíticas de asistencia por franjas horarias.</p>\n          </div>\n        </div>\n        \n        <div class=\"use-case-card relative bg-white p-12 rounded-[32px] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.03)] border border-white overflow-hidden group\" data-kid=\"74\">\n          <span class=\"absolute -bottom-10 -right-4 text-[160px] font-black text-[var(--periwinkle)]/5 z-0 select-none pointer-events-none\" data-kid=\"75\">03</span>\n          <div class=\"relative z-10\" data-kid=\"76\">\n            <div class=\"w-20 h-20 mb-8 overflow-hidden rounded-2xl\" data-kid=\"77\">\n              <img src=\"https://images.unsplash.com/photo-1712431028580-049087ee59d8?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"78\">\n            </div>\n            <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"79\">Yoga & Pilates</h4>\n            <p class=\"text-[var(--text-slate)]/60 text-lg leading-relaxed\" data-kid=\"80\">Sistema de reservas intuitivo, control de aforo y perfiles personalizados para el bienestar holístico.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"space-y-10\" data-kid=\"81\">\n        \n        <div class=\"use-case-card relative bg-white p-12 rounded-[32px] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.03)] border border-white overflow-hidden group\" data-kid=\"82\">\n          <span class=\"absolute -bottom-10 -right-4 text-[160px] font-black text-[var(--periwinkle)]/5 z-0 select-none pointer-events-none\" data-kid=\"83\">02</span>\n          <div class=\"relative z-10\" data-kid=\"84\">\n            <div class=\"w-20 h-20 mb-8 overflow-hidden rounded-2xl\" data-kid=\"85\">\n              <img src=\"https://images.unsplash.com/photo-1672212231513-791dbc80acda?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"86\">\n            </div>\n            <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"87\">Crossfit Boxes</h4>\n            <p class=\"text-[var(--text-slate)]/60 text-lg leading-relaxed\" data-kid=\"88\">Registro dinámico de WODs, rankings comunitarios y seguimiento de PRs automatizado.</p>\n          </div>\n        </div>\n        \n        <div class=\"use-case-card relative bg-white p-12 rounded-[32px] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.03)] border border-white overflow-hidden group\" data-kid=\"89\">\n          <span class=\"absolute -bottom-10 -right-4 text-[160px] font-black text-[var(--periwinkle)]/5 z-0 select-none pointer-events-none\" data-kid=\"90\">04</span>\n          <div class=\"relative z-10\" data-kid=\"91\">\n            <div class=\"w-20 h-20 mb-8 overflow-hidden rounded-2xl\" data-kid=\"92\">\n              <img src=\"https://images.unsplash.com/photo-1645708759654-c90504369738?auto=format&w=400&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-500\" decoding=\"async\" loading=\"lazy\" data-kid=\"93\">\n            </div>\n            <h4 class=\"text-3xl font-bold mb-4\" data-kid=\"94\">Martial Arts</h4>\n            <p class=\"text-[var(--text-slate)]/60 text-lg leading-relaxed\" data-kid=\"95\">Control de grados (cintas), histórico de exámenes y comunicación directa maestro-alumno.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-white/50 relative overflow-hidden\" data-kid=\"96\">\n     \n    <div id=\"scrub-shape\" class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-5 pointer-events-none\" data-kid=\"97\">\n       <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/star-formation.svg\" class=\"w-[800px] h-[800px] text-[var(--periwinkle)]\" style=\"filter: invert(53%) sepia(48%) saturate(735%) hue-rotate(193deg) brightness(98%) contrast(89%);\" data-kid=\"98\">\n    </div>\n\n    <div class=\"max-w-5xl mx-auto px-12 relative\" data-kid=\"99\">\n      <div class=\"text-center mb-32\" data-scroll data-kid=\"100\">\n        <h2 class=\"text-5xl font-extrabold\" data-kid=\"101\">Tu ascenso al <span class=\"text-[var(--periwinkle)]\" data-kid=\"102\">próximo nivel.</span></h2>\n        <p class=\"text-xl text-[var(--text-slate)]/60 mt-4\" data-kid=\"103\">Tres pasos sencillos para transformar tu gestión.</p>\n      </div>\n\n      <div class=\"relative\" data-kid=\"104\">\n        \n        <div class=\"absolute left-1/2 top-0 bottom-0 w-[2px] bg-[var(--periwinkle)]/20 -translate-x-1/2\" data-kid=\"105\"></div>\n        \n        <div class=\"space-y-48\" data-kid=\"106\">\n          \n          <div class=\"flex justify-start relative group\" data-scroll data-kid=\"107\">\n            <div class=\"w-[45%] bg-white p-10 rounded-[32px] shadow-sm border border-white hover:shadow-xl transition-shadow\" data-kid=\"108\">\n              <div class=\"flex items-center gap-6 mb-4\" data-kid=\"109\">\n                <div class=\"w-16 h-16 bg-[var(--soft-rose)] rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"110\">\n                  <span class=\"text-2xl font-black text-rose-500\" data-kid=\"111\">01</span>\n                </div>\n                <h5 class=\"text-2xl font-bold\" data-kid=\"112\">Crea tu Entorno</h5>\n              </div>\n              <p class=\"text-[var(--text-slate)]/60 leading-relaxed\" data-kid=\"113\">Define tus planes, horarios y la identidad visual de tu centro. Todo en una interfaz intuitiva.</p>\n            </div>\n            <div class=\"absolute top-1/2 -right-[calc(5%+8px)] md:-right-[calc(5%+16px)] w-6 h-6 bg-[var(--periwinkle)] rounded-full border-4 border-white shadow-lg -translate-y-1/2 z-10 glow-dot\" data-kid=\"114\"></div>\n          </div>\n\n          \n          <div class=\"flex justify-end relative group\" data-scroll data-kid=\"115\">\n            <div class=\"w-[45%] bg-white p-10 rounded-[32px] shadow-sm border border-white hover:shadow-xl transition-shadow\" data-kid=\"116\">\n               <div class=\"flex items-center gap-6 mb-4\" data-kid=\"117\">\n                <div class=\"w-16 h-16 bg-[var(--soft-yellow)] rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"118\">\n                  <span class=\"text-2xl font-black text-amber-500\" data-kid=\"119\">02</span>\n                </div>\n                <h5 class=\"text-2xl font-bold\" data-kid=\"120\">Conecta Miembros</h5>\n              </div>\n              <p class=\"text-[var(--text-slate)]/60 leading-relaxed\" data-kid=\"121\">Link de registro directo y pasarelas de pago integradas. Tus clientes se unen sin fricción.</p>\n            </div>\n            <div class=\"absolute top-1/2 -left-[calc(5%+8px)] md:-left-[calc(5%+16px)] w-6 h-6 bg-[var(--periwinkle)] rounded-full border-4 border-white shadow-lg -translate-y-1/2 z-10 glow-dot\" data-kid=\"122\"></div>\n          </div>\n\n          \n          <div class=\"flex justify-start relative group\" data-scroll data-kid=\"123\">\n            <div class=\"w-[45%] bg-white p-10 rounded-[32px] shadow-sm border border-white hover:shadow-xl transition-shadow\" data-kid=\"124\">\n              <div class=\"flex items-center gap-6 mb-4\" data-kid=\"125\">\n                <div class=\"w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center shrink-0\" data-kid=\"126\">\n                  <span class=\"text-2xl font-black text-blue-500\" data-kid=\"127\">03</span>\n                </div>\n                <h5 class=\"text-2xl font-bold\" data-kid=\"128\">Analiza y Crece</h5>\n              </div>\n              <p class=\"text-[var(--text-slate)]/60 leading-relaxed\" data-kid=\"129\">Visualiza métricas en tiempo real y recibe mentoría basada en datos para escalar tu negocio.</p>\n            </div>\n            <div class=\"absolute top-1/2 -right-[calc(5%+8px)] md:-right-[calc(5%+16px)] w-6 h-6 bg-[var(--periwinkle)] rounded-full border-4 border-white shadow-lg -translate-y-1/2 z-10 glow-dot\" data-kid=\"130\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 px-12 max-w-7xl mx-auto\" data-kid=\"131\">\n    <div class=\"text-center mb-20\" data-scroll data-kid=\"132\">\n      <h2 class=\"text-5xl font-extrabold\" data-kid=\"133\">Diseño que <span class=\"text-[var(--periwinkle)]\" data-kid=\"134\">funciona.</span></h2>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-12 md:grid-rows-2 gap-6 h-auto md:h-[700px]\" data-kid=\"135\">\n      \n      <div class=\"md:col-span-8 bg-white rounded-[40px] p-12 shadow-sm border border-white flex flex-col justify-between overflow-hidden group bento-cell\" data-kid=\"136\">\n        <div class=\"max-w-md\" data-kid=\"137\">\n          <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"138\">Acompañamiento Cercano</h3>\n          <p class=\"text-lg text-[var(--text-slate)]/60\" data-kid=\"139\">Interactúa con tus miembros a través de herramientas de comunicación in-situ. Feedback real, comunidad real.</p>\n        </div>\n        \n        <div class=\"mt-12 bg-[var(--bg-main)] p-8 rounded-[32px] max-w-sm ml-auto rotate-3 group-hover:rotate-0 transition-transform duration-500 shadow-lg\" data-kid=\"140\">\n           \n           <div class=\"space-y-6\" data-kid=\"141\">\n              <div class=\"flex items-end gap-3\" data-kid=\"142\">\n                 <div class=\"w-10 h-10 rounded-full bg-[var(--periwinkle)] shrink-0\" data-kid=\"143\"></div>\n                 <div class=\"bg-white p-4 rounded-2xl rounded-bl-none text-sm font-medium shadow-sm\" data-kid=\"144\">¿Cómo sentiste el entrenamiento hoy, Carlos?</div>\n              </div>\n              <div class=\"flex items-end gap-3 flex-row-reverse\" data-kid=\"145\">\n                 <div class=\"w-10 h-10 rounded-full bg-[var(--text-slate)] shrink-0\" data-kid=\"146\"></div>\n                 <div class=\"bg-[var(--periwinkle)] p-4 rounded-2xl rounded-br-none text-sm font-medium text-white shadow-sm\" data-kid=\"147\">¡Exigente pero genial! La nueva rutina es top.</div>\n              </div>\n           </div>\n        </div>\n      </div>\n\n      \n      <div class=\"md:col-span-4 bg-white rounded-[40px] p-12 shadow-sm border border-white flex flex-col justify-center items-center gap-10 bento-cell\" data-kid=\"148\">\n        <div class=\"text-center\" data-kid=\"149\">\n          <h4 class=\"text-2xl font-bold mb-2\" data-kid=\"150\">Metas Claras</h4>\n          <p class=\"text-[var(--text-slate)]/50\" data-kid=\"151\">Visualización de objetivos diarios.</p>\n        </div>\n        <div class=\"grid grid-cols-7 gap-3\" data-kid=\"152\">\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--periwinkle)]/20\" data-kid=\"153\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--periwinkle)]/40\" data-kid=\"154\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--periwinkle)] shadow-lg shadow-[var(--periwinkle)]/20\" data-kid=\"155\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--bg-main)]\" data-kid=\"156\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--periwinkle)]\" data-kid=\"157\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--periwinkle)]\" data-kid=\"158\"></div>\n          <div class=\"w-10 h-10 rounded-xl bg-[var(--bg-main)]\" data-kid=\"159\"></div>\n        </div>\n        <div class=\"bg-[var(--soft-rose)] px-6 py-2 rounded-full\" data-kid=\"160\">\n          <span class=\"text-[var(--periwinkle)] font-bold text-sm\" data-kid=\"161\">Racha: 5 días</span>\n        </div>\n      </div>\n\n      \n      <div class=\"md:col-span-4 bg-white rounded-[40px] p-12 shadow-sm border border-white flex flex-col justify-between bento-cell\" data-kid=\"162\">\n        <div data-kid=\"163\">\n          <h4 class=\"text-2xl font-bold mb-2\" data-kid=\"164\">Mayor Retención</h4>\n          <p class=\"text-[var(--text-slate)]/50\" data-kid=\"165\">Fideliza a través de datos.</p>\n        </div>\n        <div class=\"flex items-end gap-3 h-32\" data-kid=\"166\">\n          <div class=\"flex-1 bg-[var(--periwinkle)]/20 rounded-full h-[30%]\" data-kid=\"167\"></div>\n          <div class=\"flex-1 bg-[var(--periwinkle)]/40 rounded-full h-[55%]\" data-kid=\"168\"></div>\n          <div class=\"flex-1 bg-[var(--periwinkle)]/70 rounded-full h-[80%]\" data-kid=\"169\"></div>\n          <div class=\"flex-1 bg-[var(--periwinkle)] rounded-full h-[100%]\" data-kid=\"170\"></div>\n        </div>\n        <div class=\"mt-4\" data-kid=\"171\">\n          <span class=\"text-4xl font-black text-[var(--periwinkle)]\" data-kid=\"172\">+15%</span>\n          <p class=\"text-xs font-bold text-[var(--text-slate)]/30 uppercase mt-1\" data-kid=\"173\">Mensual</p>\n        </div>\n      </div>\n\n      \n      <div class=\"md:col-span-8 bg-[var(--text-slate)] rounded-[40px] p-12 flex flex-col md:flex-row items-center justify-between text-white relative overflow-hidden bento-cell\" data-kid=\"174\">\n        <div class=\"relative z-10 max-w-md\" data-kid=\"175\">\n          <h3 class=\"text-4xl font-extrabold mb-4\" data-kid=\"176\">Únete al Ecosistema.</h3>\n          <p class=\"text-white/60 text-lg\" data-kid=\"177\">Sé parte de la nueva era de la gestión deportiva con ITER.</p>\n        </div>\n        <button class=\"relative z-10 bg-white text-[var(--text-slate)] px-10 py-5 rounded-2xl font-extrabold text-lg hover:bg-[var(--periwinkle)] hover:text-white transition-all shadow-xl shadow-black/20\" data-kid=\"178\">\n          Solicitar Demo\n        </button>\n        \n        <div class=\"absolute top-0 right-0 w-64 h-64 bg-[var(--periwinkle)]/10 blur-[80px] rounded-full\" data-kid=\"179\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"pt-20 pb-48 px-12\" data-kid=\"180\">\n    <div id=\"footer-cta\" class=\"floating-footer-pill w-[calc(100%-64px)] max-w-6xl bg-white/80 backdrop-blur-3xl px-10 py-5 rounded-[100px] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.18)] border border-white/60 flex flex-col md:flex-row items-center justify-between gap-8\" data-kid=\"181\">\n      <div class=\"flex items-center gap-4\" data-kid=\"182\">\n        <div class=\"w-12 h-12 bg-[var(--periwinkle)] rounded-full flex items-center justify-center text-white font-bold\" data-kid=\"183\">I</div>\n        <div data-kid=\"184\">\n          <p class=\"text-sm font-bold text-[var(--text-slate)]\" data-kid=\"185\">Crear Entorno Privado</p>\n          <p class=\"text-xs text-[var(--text-slate)]/50\" data-kid=\"186\">Quantic Ecosystem © 2024</p>\n        </div>\n      </div>\n      \n      <div class=\"flex-1 max-w-md w-full relative\" data-kid=\"187\">\n        <input type=\"email\" placeholder=\"Tu email profesional\" class=\"w-full bg-[var(--bg-main)] px-8 py-4 rounded-full text-sm outline-hidden border-2 border-transparent focus:border-[var(--periwinkle)]/30 transition-all font-medium\" data-kid=\"188\">\n        <button class=\"absolute right-2 top-1.5 bottom-1.5 px-8 bg-[var(--periwinkle)] text-white rounded-full font-bold text-sm shadow-md hover:scale-105 active:scale-95 transition-transform\" data-kid=\"189\">Unirse</button>\n      </div>\n\n      <nav class=\"hidden lg:flex items-center gap-6\" data-kid=\"190\">\n        <a href=\"#\" class=\"text-xs font-bold text-[var(--text-slate)]/40 hover:text-[var(--periwinkle)] transition-colors\" data-kid=\"191\">Términos</a>\n        <a href=\"#\" class=\"text-xs font-bold text-[var(--text-slate)]/40 hover:text-[var(--periwinkle)] transition-colors\" data-kid=\"192\">Soporte</a>\n      </nav>\n    </div>\n  </footer>\n\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"193\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"194\"></script>\n<script data-kid=\"195\">gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\" data-kid=\"196\">\n  import { animate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import Snap from \"https://esm.sh/lenis@1/snap\"\n\n  // Initialize Lenis\n  const lenis = new Lenis()\n  \n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // Header Hide/Show on scroll\n  let lastScrollY = 0;\n  lenis.on('scroll', ({ scroll: currentScrollY, direction }) => {\n    const header = document.getElementById('main-header');\n    if (currentScrollY > 50) {\n      header.classList.add('bg-white/70', 'backdrop-blur-xl', 'py-4', 'shadow-sm');\n    } else {\n      header.classList.remove('bg-white/70', 'backdrop-blur-xl', 'py-4', 'shadow-sm');\n    }\n\n    if (direction === 1 && currentScrollY > 200) {\n      header.style.transform = 'translateY(-100%)';\n    } else {\n      header.style.transform = 'translateY(0)';\n    }\n  });\n\n  // Reveal animations using Intersection Observer (simple way)\n  const scrollElements = document.querySelectorAll('[data-scroll]');\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('is-inview');\n      }\n    });\n  }, { threshold: 0.1 });\n  scrollElements.forEach(el => observer.observe(el));\n\n  // #anime-ambient-float for Footer Pill\n  gsap.to(\"#footer-cta\", {\n    y: \"-=8\",\n    duration: 2.5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"power1.inOut\"\n  });\n\n  // #motion-spring-drop for Hero Mockup\n  animate(\"#hero-mockup\", \n    { y: [100, 0], opacity: [0, 1] }, \n    { type: \"spring\", stiffness: 150, damping: 15, delay: 0.2 }\n  );\n\n  // #motion-target-scrub-rotation\n  scroll(\n    animate(\"#scrub-shape img\", { rotate: [0, 360] }),\n    { target: document.querySelector('#scrub-shape'), offset: [\"start end\", \"end start\"] }\n  );\n\n  // #gsap-scroll-batch for Use Case Cards\n  ScrollTrigger.batch(\".use-case-card\", {\n    onEnter: batch => gsap.to(batch, { opacity: 1, y: 0, stagger: 0.15, duration: 0.8, ease: \"expo.out\" }),\n    start: \"top 85%\",\n  });\n  // Reset for animation destination\n  gsap.set(\".use-case-card\", { opacity: 0, y: 50 });\n\n  // #motion-hover-glow for Bento Cells\n  document.querySelectorAll('.bento-cell').forEach(cell => {\n    cell.addEventListener('mouseenter', () => {\n      animate(cell, { boxShadow: \"0 20px 50px rgba(122, 140, 235, 0.15)\" }, { duration: 0.4 });\n    });\n    cell.addEventListener('mouseleave', () => {\n      animate(cell, { boxShadow: \"0 1px 3px rgba(0, 0, 0, 0.05)\" }, { duration: 0.4 });\n    });\n  });\n\n  // Tab Switching Logic\n  const tabs = document.querySelectorAll('.tab-trigger');\n  tabs.forEach(tab => {\n    tab.addEventListener('click', () => {\n      tabs.forEach(t => {\n        t.classList.remove('active', 'bg-white', 'text-[var(--periwinkle)]', 'border-b-2');\n        t.classList.add('bg-white/40', 'text-[var(--text-slate)]/50');\n      });\n      tab.classList.add('active', 'bg-white', 'text-[var(--periwinkle)]', 'border-b-2');\n      tab.classList.remove('bg-white/40', 'text-[var(--text-slate)]/50');\n      \n      // Simple switch animation\n      gsap.fromTo(\"#hero-mockup\", { scale: 0.98 }, { scale: 1, duration: 0.5, ease: \"back.out(2)\" });\n    });\n  });\n\n</script>\n",
