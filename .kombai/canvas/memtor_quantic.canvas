      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap');\n\n    :root {\n        --mentor-accent: #6366F1;\n        --gym-accent: #10B981;\n        --bg-color: #0B0F19;\n        --hairline: rgba(255, 255, 255, 0.1);\n    }\n\n    body {\n        margin: 0;\n        background-color: var(--bg-color);\n        color: white;\n        font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    .font-outfit { font-family: 'Outfit', sans-serif; }\n    .hairline-border { border: 1px solid var(--hairline); }\n    .hairline-b { border-bottom: 1px solid var(--hairline); }\n    .hairline-r { border-right: 1px solid var(--hairline); }\n    .hairline-l { border-left: 1px solid var(--hairline); }\n    .hairline-t { border-top: 1px solid var(--hairline); }\n\n    .masonry-grid {\n        display: grid;\n        grid-template-columns: repeat(12, 1fr);\n        gap: 0;\n    }\n\n    /* Hide scrollbar for Chrome, Safari and Opera */\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n\n    /* Hide scrollbar for IE, Edge and Firefox */\n    .no-scrollbar {\n        -ms-overflow-style: none;  /* IE and Edge */\n        scrollbar-width: none;  /* Firefox */\n    }\n\n    /* Custom sizing for value ramp */\n    .ramp-item {\n        transition: height 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n</style>\n\n<div class=\"min-h-screen selection:bg-white selection:text-black overflow-x-clip\" data-kid=\"1\">\n    \n    <header class=\"hairline-b flex items-center justify-between px-10 py-6 sticky top-0 bg-[#0B0F19]/80 backdrop-blur-md z-50\" data-kid=\"2\">\n        <div class=\"flex items-center gap-12\" data-kid=\"3\">\n            <div class=\"font-outfit text-2xl font-black tracking-tighter uppercase\" data-kid=\"4\">Memtor<span class=\"text-white/40\" data-kid=\"5\">Quantic</span></div>\n            <nav class=\"hidden md:flex items-center gap-8 text-xs font-medium uppercase tracking-widest text-white/50\" data-kid=\"6\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"7\">Platform</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"8\">Ecosystems</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"9\">Pricing</a>\n            </nav>\n        </div>\n        <div class=\"flex items-center gap-6\" data-kid=\"10\">\n            <a href=\"#\" class=\"text-xs font-medium uppercase tracking-widest text-white/50 hover:text-white transition-colors\" data-kid=\"11\">Login</a>\n            <button class=\"bg-white text-black px-6 py-2 text-xs font-bold uppercase tracking-widest hover:bg-white/90 transition-colors\" data-kid=\"12\">Get Access</button>\n        </div>\n    </header>\n\n    \n    <section class=\"px-10 pt-24 pb-0\" data-kid=\"13\">\n        <div class=\"relative mb-12 overflow-hidden\" data-kid=\"14\">\n            <h1 id=\"main-headline\" class=\"font-outfit text-[14vw] leading-[0.85] tracking-tighter uppercase font-black\" data-kid=\"15\">\n                STARK<br data-kid=\"16\">EVOLUTION\n            </h1>\n        </div>\n        \n        <div class=\"grid grid-cols-12 gap-0 hairline-t pt-8 mb-24\" data-kid=\"17\">\n            <div class=\"col-span-12 md:col-span-5\" data-kid=\"18\">\n                <p class=\"text-xl text-white/60 leading-relaxed font-light\" data-kid=\"19\">\n                    The dual-ecosystem infrastructure for the next generation of high-ticket coaching and physical academy chains. Precision architecture for elite performance.\n                </p>\n            </div>\n            <div class=\"col-span-12 md:col-span-7 flex justify-end items-end gap-12 mt-8 md:mt-0\" data-kid=\"20\">\n                <div class=\"text-right\" data-kid=\"21\">\n                    <div class=\"text-[var(--mentor-accent)] font-outfit text-sm font-bold uppercase tracking-widest mb-1\" data-kid=\"22\">Active nodes</div>\n                    <div class=\"font-outfit text-4xl font-bold\" data-kid=\"23\">4,129</div>\n                </div>\n                <div class=\"text-right\" data-kid=\"24\">\n                    <div class=\"text-[var(--gym-accent)] font-outfit text-sm font-bold uppercase tracking-widest mb-1\" data-kid=\"25\">Settled Vol</div>\n                    <div class=\"font-outfit text-4xl font-bold\" data-kid=\"26\">$12.4M</div>\n                </div>\n            </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-2 hairline-border bg-white/2\" data-kid=\"27\">\n            <button id=\"toggle-mentor\" class=\"group relative py-12 md:py-16 px-8 md:px-12 text-left hairline-r transition-colors duration-300 hover:bg-white/[0.04] cursor-pointer outline-hidden focus:bg-white/[0.05]\" data-kid=\"28\">\n                <div class=\"absolute top-0 left-0 right-0 h-1.5 bg-[var(--mentor-accent)] scale-x-100 origin-left transition-transform duration-500\" id=\"mentor-indicator\" data-kid=\"29\"></div>\n                <span class=\"block font-outfit text-[10px] md:text-xs uppercase tracking-[0.25em] text-white/40 mb-4\" data-kid=\"30\">Ecosystem 01</span>\n                <h3 class=\"font-outfit text-4xl md:text-7xl uppercase font-black leading-tight\" id=\"mentor-title\" data-kid=\"31\">Mentors</h3>\n                <p class=\"mt-6 text-white/50 text-sm md:text-base font-medium max-w-sm transition-all duration-500\" id=\"mentor-desc\" data-kid=\"32\">Advanced logic for high-ticket coaching, curriculum management, and private client portals.</p>\n            </button>\n            <button id=\"toggle-gym\" class=\"group relative py-12 md:py-16 px-8 md:px-12 text-left transition-colors duration-300 hover:bg-white/[0.04] cursor-pointer outline-hidden focus:bg-white/[0.05]\" data-kid=\"33\">\n                <div class=\"absolute top-0 left-0 right-0 h-1.5 bg-[var(--gym-accent)] scale-x-0 origin-left transition-transform duration-500\" id=\"gym-indicator\" data-kid=\"34\"></div>\n                <span class=\"block font-outfit text-[10px] md:text-xs uppercase tracking-[0.25em] text-white/40 mb-4\" data-kid=\"35\">Ecosystem 02</span>\n                <h3 class=\"font-outfit text-4xl md:text-7xl uppercase font-black leading-tight text-white/20 transition-all duration-500\" id=\"gym-title\" data-kid=\"36\">Academies</h3>\n                <p class=\"mt-6 text-white/10 text-sm md:text-base font-medium max-w-sm transition-all duration-500\" id=\"gym-desc\" data-kid=\"37\">Structural chain management, attendance biometrics, and multi-location revenue routing.</p>\n            </button>\n        </div>\n    </section>\n\n    \n    <section class=\"grid grid-cols-12 gap-0 border-b border-white/10 min-h-[80vh]\" data-kid=\"38\">\n        <div class=\"col-span-12 lg:col-span-5 p-16 flex flex-col justify-center hairline-r\" data-kid=\"39\">\n            <span class=\"text-[var(--mentor-accent)] font-outfit text-xs font-bold uppercase tracking-[0.3em] mb-6\" id=\"preview-tag\" data-kid=\"40\">01 / DASHBOARD LOGIC</span>\n            <h2 class=\"font-outfit text-5xl md:text-6xl uppercase font-black leading-[0.9] tracking-tighter mb-8\" id=\"preview-title\" data-kid=\"41\">DATA<br data-kid=\"42\">STRUCTURALISM</h2>\n            <p class=\"text-white/50 text-lg max-w-md mb-12\" id=\"preview-desc\" data-kid=\"43\">\n                High data-ink ratio visualizations that expose the raw mechanics of your business. No fluff, just the structural lines of your growth.\n            </p>\n            <div class=\"flex items-center gap-4\" data-kid=\"44\">\n                <div class=\"w-12 h-px bg-white/20\" data-kid=\"45\"></div>\n                <button class=\"font-outfit text-xs font-bold uppercase tracking-widest text-white/60 hover:text-white transition-colors\" data-kid=\"46\">Explore Interface</button>\n            </div>\n        </div>\n        <div class=\"col-span-12 lg:col-span-7 bg-[#080B14] p-8 md:p-12 overflow-hidden relative flex items-center\" data-kid=\"47\">\n            <div id=\"mockup-container\" class=\"relative z-10 -mr-20 md:-mr-40 mt-4 md:mt-10 w-full\" data-kid=\"48\">\n                <div class=\"bg-[#121826] border border-white/10 rounded-lg p-4 md:p-8 shadow-2xl overflow-hidden\" data-kid=\"49\">\n                    <div class=\"flex items-center justify-between mb-8 border-b border-white/5 pb-4\" data-kid=\"50\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"51\">\n                            <div class=\"w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50\" data-kid=\"52\"></div>\n                            <div class=\"w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50\" data-kid=\"53\"></div>\n                            <div class=\"w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50\" data-kid=\"54\"></div>\n                        </div>\n                        <div class=\"text-[10px] uppercase font-bold text-white/20 tracking-widest\" data-kid=\"55\">System_v2.01_Active</div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-6\" data-kid=\"56\">\n                        <div class=\"col-span-2 bg-black/40 border border-white/5 p-8 rounded h-64 relative overflow-hidden\" data-kid=\"57\">\n                             \n                             <svg viewBox=\"0 0 800 200\" class=\"w-full h-full stroke-[var(--mentor-accent)] fill-none stroke-2 opacity-80\" id=\"preview-chart\" data-kid=\"58\">\n                                <path d=\"M0,180 Q100,160 200,170 T400,120 T600,60 T800,20\" data-kid=\"59\"></path>\n                                <circle cx=\"600\" cy=\"60\" r=\"4\" fill=\"var(--mentor-accent)\" data-kid=\"60\"></circle>\n                                <rect x=\"580\" y=\"20\" width=\"80\" height=\"25\" fill=\"white/5\" class=\"hairline-border\" data-kid=\"61\"></rect>\n                                <text x=\"590\" y=\"38\" fill=\"white\" font-size=\"10\" font-family=\"Outfit\" font-weight=\"bold\" data-kid=\"62\">+128% VELOCITY</text>\n                             </svg>\n                        </div>\n                        <div class=\"bg-black/40 border border-white/5 p-6 rounded h-40\" data-kid=\"63\">\n                            <div class=\"h-2 w-1/3 bg-white/10 mb-4\" data-kid=\"64\"></div>\n                            <div class=\"space-y-2\" data-kid=\"65\">\n                                <div class=\"h-1.5 w-full bg-white/5\" data-kid=\"66\"></div>\n                                <div class=\"h-1.5 w-4/5 bg-white/5\" data-kid=\"67\"></div>\n                                <div class=\"h-1.5 w-2/3 bg-white/5\" data-kid=\"68\"></div>\n                            </div>\n                        </div>\n                        <div class=\"bg-black/40 border border-white/5 p-6 rounded h-40\" data-kid=\"69\">\n                            <div class=\"h-2 w-1/4 bg-[var(--mentor-accent)] mb-4\" id=\"preview-accent-bar\" data-kid=\"70\"></div>\n                            <div class=\"flex items-end justify-between h-20\" data-kid=\"71\">\n                                <div class=\"w-4 bg-white/10 h-10\" data-kid=\"72\"></div>\n                                <div class=\"w-4 bg-white/10 h-16\" data-kid=\"73\"></div>\n                                <div class=\"w-4 bg-white/20 h-20\" data-kid=\"74\"></div>\n                                <div class=\"w-4 bg-[var(--mentor-accent)] h-12\" id=\"preview-bar-active\" data-kid=\"75\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"absolute inset-0 pointer-events-none opacity-20\" style=\"background-image: radial-gradient(var(--hairline) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"76\"></div>\n        </div>\n    </section>\n\n    \n    \n        <div 