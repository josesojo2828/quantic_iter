Settlement_Init: ID_8829</div>\n                            <div data-kid=\"111\">[14:22:04] Ledger_Entry: +$1,200.00</div>\n                            <div data-kid=\"112\">[14:22:09] SMS_Webhook: SENT</div>\n                            <div data-kid=\"113\">[14:22:15] CRM_Update: Lead_P0</div>\n                            <div class=\"text-white/60\" data-kid=\"114\">[14:23:44] NEW_ACADEMY_REGISTERED: \"Apex Fitness\"</div>\n                            <div data-kid=\"115\">[14:23:45] Biometric_Provisioning: START</div>\n                            <div data-kid=\"116\">[14:24:01] Settlement_Init: ID_8830</div>\n                            <div data-kid=\"117\">[14:24:05] Ledger_Entry: +$599.00</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            \n            <div class=\"col-span-12 md:col-span-7 hairline-r hairline-b p-10 h-[450px]\" data-kid=\"118\">\n                <span class=\"font-outfit text-xs font-bold text-white/30 tracking-[0.3em]\" data-kid=\"119\">03 / BRANDING</span>\n                <h4 class=\"font-outfit text-3xl uppercase font-black mt-4\" data-kid=\"120\">WHITE-LABEL<br data-kid=\"121\">ARCHITECTURE</h4>\n                <div class=\"grid grid-cols-2 gap-px bg-white/10 mt-12 border border-white/10\" data-kid=\"122\">\n                    <div class=\"bg-[#0B0F19] p-8 text-center relative group\" data-kid=\"123\">\n                        <div class=\"text-[10px] absolute top-2 left-2 uppercase font-bold text-red-500/60\" data-kid=\"124\">Standard</div>\n                        <div class=\"w-16 h-16 bg-white/5 rounded-full mx-auto mb-4 border border-white/10 flex items-center justify-center\" data-kid=\"125\">\n                            <i class=\"ph ph-circle text-white/20 text-2xl\" data-kid=\"126\"></i>\n                        </div>\n                        <div class=\"h-2 w-12 bg-white/10 mx-auto\" data-kid=\"127\"></div>\n                    </div>\n           