      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Outfit:wght@300;400;600&display=swap');\n\n    :root {\n        --bg: #0B0F19;\n        --violet: #8B5CF6;\n        --teal: #06B6D4;\n        --surface: #151A28;\n    }\n\n    body {\n        background-color: var(--bg);\n        color: white;\n        font-family: 'Outfit', sans-serif;\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    .font-heading { font-family: 'Inter', sans-serif; }\n    \n    .isometric-container {\n        perspective: 2000px;\n    }\n\n    .isometric-stack {\n        transform: rotateX(55deg) rotateZ(-45deg);\n        transform-style: preserve-3d;\n    }\n\n    .glass-card {\n        background: rgba(255, 255, 255, 0.03);\n        backdrop-filter: blur(12px);\n        border: 1px solid rgba(255, 255, 255, 0.1);\n    }\n\n    .neo-glow-violet {\n        box-shadow: 0 0 20px rgba(139, 92, 246, 0.15), 0 0 40px rgba(139, 92, 246, 0.05);\n    }\n    \n    .neo-glow-teal {\n        box-shadow: 0 0 20px rgba(6, 182, 212, 0.15), 0 0 40px rgba(6, 182, 212, 0.05);\n    }\n\n    /* Hide scrollbars but keep functionality */\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* Custom horizontal scroll container for features */\n    .horizontal-scroll-container {\n        display: flex;\n        overflow-x: auto;\n        scroll-snap-type: x mandatory;\n        padding-left: 10%;\n        padding-right: 10%;\n        scrollbar-width: none;\n    }\n    \n    .feature-card {\n        flex: 0 0 70%;\n        scroll-snap-align: center;\n        margin-right: 2rem;\n    }\n</style>\n\n\n<nav id=\"dock\" class=\"fixed bottom-8 left-1/2 -translate-x-1/2 z-[100] flex items-end gap-2 px-4 py-3 bg-[#151A28]/80 backdrop-blur-2xl border border-white/10 rounded-3xl shadow-2xl\" data-kid=\"1\">\n    <div class=\"dock-item group relative flex flex-col items-center\" data-kid=\"2\">\n        <div class=\"w-12 h-12 bg-white/5 hover:bg-white/10 rounded-2xl flex items-center justify-center border border-white/5 cursor-pointer\" data-kid=\"3\">\n            <i class=\"fa-solid fa-house text-slate-400 group-hover:text-white text-lg\" data-kid=\"4\"></i>\n        </div>\n        <div class=\"absolute -top-10 scale-0 group-hover:scale-100 transition-all bg-slate-900 text-white text-xs px-2 py-1 rounded-md\" data-kid=\"5\">Home</div>\n    </div>\n    <div class=\"dock-item group relative flex flex-col items-center\" data-kid=\"6\">\n        <div class=\"w-12 h-12 bg-violet-600 rounded-2xl flex items-center justify-center shadow-[0_0_20px_rgba(139,92,246,0.4)] cursor-pointer\" data-kid=\"7\">\n            <i class=\"fa-solid fa-rocket text-white text-lg\" data-kid=\"8\"></i>\n        </div>\n        <div class=\"absolute -top-10 scale-0 group-hover:scale-100 transition-all bg-slate-900 text-white text-xs px-2 py-1 rounded-md\" data-kid=\"9\">Features</div>\n    </div>\n    <div class=\"w-px h-8 bg-white/10 mx-2 self-center\" data-kid=\"10\"></div>\n    <div class=\"dock-item group relative flex flex-col items-center\" data-kid=\"11\">\n        <div class=\"w-12 h-12 bg-white/5 hover:bg-white/10 rounded-2xl flex items-center justify-center border border-white/5 cursor-pointer\" data-kid=\"12\">\n            <i class=\"fa-solid fa-chart-pie text-slate-400 group-hover:text-white text-lg\" data-kid=\"13\"></i>\n        </div>\n        <div class=\"absolute -top-10 scale-0 group-hover:scale-100 transition-all bg-slate-900 text-white text-xs px-2 py-1 rounded-md\" data-kid=\"14\">Stats</div>\n    </div>\n    <div class=\"dock-item group relative flex flex-col items-center\" data-kid=\"15\">\n        <div class=\"w-12 h-12 bg-white/5 hover:bg-white/10 rounded-2xl flex items-center justify-center border border-white/5 cursor-pointer\" data-kid=\"16\">\n            <i class=\"fa-solid fa-gear text-slate-400 group-hover:text-white text-lg\" data-kid=\"17\"></i>\n        </div>\n    </div>\n</nav>\n\n\n<main id=\"main-content\" data-kid=\"18\">\n    \n    \n    <section id=\"hero\" class=\"relative min-h-screen flex flex-col items-center justify-center pt-20 overflow-hidden\" data-kid=\"19\">\n        \n        <div class=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-violet-600/10 blur-[120px] rounded-full pointer-events-none\" data-kid=\"20\"></div>\n        <div class=\"absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-teal-600/10 blur-[120px] rounded-full pointer-events-none\" data-kid=\"21\"></div>\n\n        <div class=\"z-10 text-center px-6\" data-kid=\"22\">\n            <span class=\"inline-block px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-400 text-xs font-semibold tracking-widest uppercase mb-6\" data-kid=\"23\">Introducing Quantic v3</span>\n            <h1 class=\"font-heading text-6xl md:text-8xl font-black tracking-tighter mb-6 leading-tight\" data-kid=\"24\">\n                SPATIAL<br data-kid=\"25\"><span class=\"text-slate-500\" data-kid=\"26\">INTELLIGENCE.</span>\n            </h1>\n            <p class=\"text-xl text-slate-400 max-w-2xl mx-auto font-light leading-relaxed\" data-kid=\"27\">\n                Unlock deep insights for your coaching ecosystem. The first spatial platform built for Mentors and Gym Owners.\n            </p>\n            \n            \n            <div class=\"mt-12 inline-flex p-1.5 bg-slate-900/80 backdrop-blur border border-slate-800 rounded-2xl\" data-kid=\"28\">\n                <button class=\"toggle-btn px-8 py-3 rounded-xl bg-violet-600 text-white font-semibold shadow-lg shadow-violet-600/20 transition-all\" data-kid=\"29\">Mentors</button>\n                <button class=\"toggle-btn px-8 py-3 rounded-xl text-slate-500 hover:text-white font-semibold transition-all\" data-kid=\"30\">Gyms</button>\n            </div>\n        </div>\n\n        \n        <div class=\"relative w-full max-w-5xl h-[600px] mt-12 isometric-container\" style=\"perspective-origin: 50% 50%;\" data-kid=\"31\">\n            <div id=\"hero-stack\" class=\"isometric-stack relative w-full h-full flex items-center justify-center\" data-kid=\"32\">\n                \n                <div class=\"stack-layer absolute w-[400px] h-[500px] bg-[#151A28] border border-slate-800 rounded-3xl shadow-xl flex flex-col p-8\" style=\"transform: translateZ(0px);\" data-kid=\"33\">\n                    <div class=\"flex items-center gap-4 mb-10\" data-kid=\"34\">\n                        <div class=\"w-10 h-10 rounded-lg bg-slate-800 border border-slate-700\" data-kid=\"35\"></div>\n                        <div class=\"h-4 bg-slate-800 rounded w-32\" data-kid=\"36\"></div>\n                    </div>\n                    <div class=\"space-y-6\" data-kid=\"37\">\n                        <div class=\"h-3 bg-slate-800/50 rounded-full w-full\" data-kid=\"38\"></div>\n                        <div class=\"h-3 bg-slate-800/50 rounded-full w-full\" data-kid=\"39\"></div>\n                        <div class=\"h-3 bg-slate-800/50 rounded-full w-4/5\" data-kid=\"40\"></div>\n                    </div>\n                    <div class=\"mt-auto grid grid-cols-2 gap-4\" data-kid=\"41\">\n                        <div class=\"h-24 bg-slate-800/30 rounded-2xl\" data-kid=\"42\"></div>\n                        <div class=\"h-24 bg-slate-800/30 rounded-2xl\" data-kid=\"43\"></div>\n                    </div>\n                </div>\n                \n                \n                <div class=\"stack-layer absolute w-[400px] h-[500px] bg-slate-800/40 backdrop-blur-md border border-white/5 rounded-3xl shadow-2xl flex flex-col p-8\" style=\"transform: translateZ(60px);\" data-kid=\"44\">\n                    <div class=\"h-40 bg-gradient-to-br from-teal-500/20 to-transparent rounded-2xl border border-teal-500/10 mb-8 flex items-end p-4\" data-kid=\"45\">\n                        <div class=\"flex gap-2 w-full\" data-kid=\"46\">\n                            <div class=\"h-10 bg-teal-400/30 w-full rounded-t-sm\" data-kid=\"47\"></div>\n                            <div class=\"h-16 bg-teal-400/40 w-full rounded-t-sm\" data-kid=\"48\"></div>\n                            <div class=\"h-24 bg-teal-400/60 w-full rounded-t-sm\" data-kid=\"49\"></div>\n                            <div class=\"h-14 bg-teal-400/30 w-full rounded-t-sm\" data-kid=\"50\"></div>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-3 gap-3\" data-kid=\"51\">\n                        <div class=\"h-12 bg-white/5 rounded-lg\" data-kid=\"52\"></div>\n                        <div class=\"h-12 bg-white/5 rounded-lg\" data-kid=\"53\"></div>\n                        <div class=\"h-12 bg-white/5 rounded-lg\" data-kid=\"54\"></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"stack-layer absolute w-[400px] h-[500px] glass-card rounded-3xl shadow-2xl flex flex-col p-8\" style=\"transform: translateZ(120px);\" data-kid=\"55\">\n                    <div class=\"w-full h-full border border-white/10 rounded-2xl flex flex-col items-center justify-center text-center p-6\" data-kid=\"56\">\n                        <div class=\"w-20 h-20 rounded-full bg-violet-600/20 flex items-center justify-center mb-6\" data-kid=\"57\">\n                            <i class=\"fa-solid fa-fingerprint text-3xl text-violet-400\" data-kid=\"58\"></i>\n                        </div>\n                        <h4 class=\"text-xl font-bold mb-2\" data-kid=\"59\">Secure Sync</h4>\n                        <p class=\"text-slate-400 text-sm\" data-kid=\"60\">Real-time biometric data processing enabled.</p>\n                        <div class=\"mt-8 w-full py-3 bg-violet-600 rounded-xl font-bold\" data-kid=\"61\">ACTIVATE</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"narrative\" class=\"min-h-screen relative flex items-center justify-center py-32 bg-slate-950/50\" data-kid=\"62\">\n        <div class=\"container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\" data-kid=\"63\">\n            <div class=\"space-y-8 z-10\" data-kid=\"64\">\n                <h2 class=\"font-heading text-5xl font-bold tracking-tight\" data-kid=\"65\">The interface that <br data-kid=\"66\"><span class=\"text-teal-400\" data-kid=\"67\">adapts to your scale.</span></h2>\n                <p class=\"text-slate-400 text-lg leading-relaxed max-w-lg\" data-kid=\"68\">\n                    As you grow, Memtor Quantic expands with you. Our spatial architecture ensures you never lose sight of the details while maintaining a bird's-eye view of your entire operation.\n                </p>\n                <ul class=\"space-y-4\" data-kid=\"69\">\n                    <li class=\"flex items-center gap-3 text-white\" data-kid=\"70\">\n                        <div class=\"w-6 h-6 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400\" data-kid=\"71\"><i class=\"fa-solid fa-check text-[10px]\" data-kid=\"72\"></i></div>\n                        Real-time body composition tracking\n                    </li>\n                    <li class=\"flex items-center gap-3 text-white\" data-kid=\"73\">\n                        <div class=\"w-6 h-6 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400\" data-kid=\"74\"><i class=\"fa-solid fa-check text-[10px]\" data-kid=\"75\"></i></div>\n                        Automated billing and white-labeling\n                    </li>\n                    <li class=\"flex items-center gap-3 text-white\" data-kid=\"76\">\n                        <div class=\"w-6 h-6 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400\" data-kid=\"77\"><i class=\"fa-solid fa-check text-[10px]\" data-kid=\"78\"></i></div>\n                        Advanced CRM with predictive churn analysis\n                    </li>\n                </ul>\n            </div>\n            \n            <div class=\"relative h-[600px] flex items-center justify-center\" data-kid=\"79\">\n                \n                <div id=\"product-preview\" class=\"w-full max-w-md aspect-[4/5] bg-[#151A28] border border-slate-800 rounded-3xl shadow-2xl overflow-hidden relative\" data-kid=\"80\">\n                    <div class=\"absolute inset-0 bg-gradient-to-b from-slate-900/50 to-transparent p-8\" data-kid=\"81\">\n                        <div class=\"flex items-center justify-between mb-12\" data-kid=\"82\">\n                            <div class=\"w-8 h-8 rounded-full bg-teal-500/30\" data-kid=\"83\"></div>\n                            <div class=\"flex gap-2\" data-kid=\"84\">\n                                <div class=\"w-6 h-2 bg-slate-800 rounded-full\" data-kid=\"85\"></div>\n                                <div class=\"w-6 h-2 bg-slate-800 rounded-full\" data-kid=\"86\"></div>\n                            </div>\n                        </div>\n                        <div class=\"space-y-8\" data-kid=\"87\">\n                            <div class=\"space-y-3\" data-kid=\"88\">\n                                <div class=\"h-2 w-20 bg-slate-800 rounded-full\" data-kid=\"89\"></div>\n                                <div class=\"h-8 w-48 bg-white/5 rounded-lg\" data-kid=\"90\"></div>\n                            </div>\n                            <div class=\"h-40 bg-white/5 border border-white/5 rounded-2xl relative overflow-hidden p-4\" data-kid=\"91\">\n                                <div class=\"absolute bottom-0 left-0 w-full h-1/2 bg-teal-500/10\" data-kid=\"92\"></div>\n                                <div class=\"flex items-end h-full gap-2\" data-kid=\"93\">\n                                    <div class=\"w-full bg-teal-500/40 h-1/2 rounded-t-sm\" data-kid=\"94\"></div>\n                                    <div class=\"w-full bg-teal-500/40 h-3/4 rounded-t-sm\" data-kid=\"95\"></div>\n                                    <div class=\"w-full bg-teal-500/40 h-2/3 rounded-t-sm\" data-kid=\"96\"></div>\n                                    <div class=\"w-full bg-teal-500/40 h-full rounded-t-sm\" data-kid=\"97\"></div>\n                                </div>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-4\" data-kid=\"98\">\n                                <div class=\"h-20 bg-white/5 rounded-2xl\" data-kid=\"99\"></div>\n                                <div class=\"h-20 bg-white/5 rounded-2xl\" data-kid=\"100\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"features\" class=\"py-32 overflow-hidden bg-slate-950\" data-kid=\"101\">\n        <div class=\"container mx-auto px-6 mb-20\" data-kid=\"102\">\n            <h2 class=\"font-heading text-4xl font-bold\" data-kid=\"103\">Powerful for Mentors.<br data-kid=\"104\"><span class=\"text-violet-400\" data-kid=\"105\">Essential for Gyms.</span></h2>\n        </div>\n        \n        <div class=\"horizontal-scroll-container no-scrollbar\" data-kid=\"106\">\n            \n            <div class=\"feature-card h-[450px] bg-[#151A28] border border-slate-800 rounded-[2.5rem] p-12 flex flex-col justify-between group overflow-hidden relative\" data-kid=\"107\">\n                <div class=\"absolute top-0 right-0 w-64 h-64 bg-violet-600/10 blur-[80px] -translate-y-1/2 translate-x-1/2\" data-kid=\"108\"></div>\n                <div data-kid=\"109\">\n                    <div class=\"w-16 h-16 bg-violet-600/20 rounded-2xl flex items-center justify-center mb-8 border border-violet-500/20 text-violet-400\" data-kid=\"110\">\n                        <i class=\"fa-solid fa-layer-group text-2xl\" data-kid=\"111\"></i>\n                    </div>\n                    <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"112\">Unified Ecosystem</h3>\n                    <p class=\"text-slate-400 text-lg leading-relaxed max-w-sm\" data-kid=\"113\">Manage both coaching and facility operations from a single spatial interface.</p>\n                </div>\n                <div class=\"flex items-center gap-4 text-violet-400 font-semibold group-hover:gap-6 transition-all\" data-kid=\"114\">\n                    EXPLORE MODULE <i class=\"fa-solid fa-arrow-right\" data-kid=\"115\"></i>\n                </div>\n            </div>\n            \n            \n            <div class=\"feature-card h-[450px] bg-[#151A28] border border-slate-800 rounded-[2.5rem] p-12 flex flex-col justify-between group overflow-hidden relative\" data-kid=\"116\">\n                <div class=\"absolute top-0 right-0 w-64 h-64 bg-teal-600/10 blur-[80px] -translate-y-1/2 translate-x-1/2\" data-kid=\"117\"></div>\n                <div data-kid=\"118\">\n                    <div class=\"w-16 h-16 bg-teal-600/20 rounded-2xl flex items-center justify-center mb-8 border border-teal-500/20 text-teal-400\" data-kid=\"119\">\n                        <i class=\"fa-solid fa-chart-line text-2xl\" data-kid=\"120\"></i>\n                    </div>\n                    <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"121\">Deep Analytics</h3>\n                    <p class=\"text-slate-400 text-lg leading-relaxed max-w-sm\" data-kid=\"122\">Predictive churn analysis and client progress heatmaps for smarter retention.</p>\n                </div>\n                <div class=\"flex items-center gap-4 text-teal-400 font-semibold group-hover:gap-6 transition-all\" data-kid=\"123\">\n                    VIEW DASHBOARD <i class=\"fa-solid fa-arrow-right\" data-kid=\"124\"></i>\n                </div>\n            </div>\n            \n            \n            <div class=\"feature-card h-[450px] bg-[#151A28] border border-slate-800 rounded-[2.5rem] p-12 flex flex-col justify-between group overflow-hidden relative\" data-kid=\"125\">\n                <div class=\"absolute top-0 right-0 w-64 h-64 bg-slate-600/10 blur-[80px] -translate-y-1/2 translate-x-1/2\" data-kid=\"126\"></div>\n                <div data-kid=\"127\">\n                    <div class=\"w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mb-8 border border-white/10 text-white\" data-kid=\"128\">\n                        <i class=\"fa-solid fa-wand-magic-sparkles text-2xl\" data-kid=\"129\"></i>\n                    </div>\n                    <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"130\">White-Labeling</h3>\n                    <p class=\"text-slate-400 text-lg leading-relaxed max-w-sm\" data-kid=\"131\">Your brand, our engine. Fully custom domains, emails, and mobile app experiences.</p>\n                </div>\n                <div class=\"flex items-center gap-4 text-white font-semibold group-hover:gap-6 transition-all\" data-kid=\"132\">\n                    GET STARTED <i class=\"fa-solid fa-arrow-right\" data-kid=\"133\"></i>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"pricing\" class=\"py-32 bg-[#0B0F19] flex flex-col items-center\" data-kid=\"134\">\n        <div class=\"container mx-auto px-6 text-center mb-20\" data-kid=\"135\">\n            <h2 class=\"font-heading text-5xl font-bold mb-6\" data-kid=\"136\">Scale at your <span class=\"text-teal-400\" data-kid=\"137\">own pace.</span></h2>\n            <p class=\"text-slate-400 max-w-xl mx-auto text-lg\" data-kid=\"138\">Predictable pricing that grows with your client base. No hidden fees, just pure growth.</p>\n        </div>\n        \n        <div class=\"relative w-[320px] h-[320px] md:w-[450px] md:h-[450px] flex items-center justify-center\" data-kid=\"139\">\n            \n            <svg class=\"absolute inset-0 w-full h-full -rotate-90\" viewBox=\"0 0 100 100\" data-kid=\"140\">\n                <circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"#151A28\" stroke-width=\"6\" data-kid=\"141\"></circle>\n                <circle id=\"radial-progress\" cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"url(#pricing-gradient)\" stroke-width=\"6\" stroke-dasharray=\"289\" stroke-dashoffset=\"180\" stroke-linecap=\"round\" data-kid=\"142\"></circle>\n                <defs data-kid=\"143\">\n                    <linearGradient id=\"pricing-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"144\">\n                        <stop offset=\"0%\" style=\"stop-color:#8B5CF6\" data-kid=\"145\"></stop>\n                        <stop offset=\"100%\" style=\"stop-color:#06B6D4\" data-kid=\"146\"></stop>\n                    </linearGradient>\n                </defs>\n            </svg>\n            \n            \n            <div class=\"relative z-10 w-64 h-64 md:w-80 md:h-80 rounded-full bg-[#151A28] border border-slate-800 shadow-[0_0_60px_rgba(0,0,0,0.5),inset_0_2px_10px_rgba(255,255,255,0.05)] flex flex-col items-center justify-center cursor-pointer group\" data-kid=\"147\">\n                <span class=\"text-slate-500 text-xs md:text-sm uppercase tracking-widest mb-2\" data-kid=\"148\">Monthly investment</span>\n                <div class=\"flex items-baseline gap-1\" data-kid=\"149\">\n                    <span class=\"text-5xl md:text-7xl font-black text-white\" data-kid=\"150\">$499</span>\n                    <span class=\"text-slate-500 font-bold\" data-kid=\"151\">/mo</span>\n                </div>\n                <div class=\"mt-4 px-4 py-1.5 bg-teal-500/20 text-teal-300 rounded-full text-sm font-bold border border-teal-500/30\" data-kid=\"152\">\n                    1,250 CLIENTS\n                </div>\n                <div class=\"absolute -bottom-4 bg-violet-600 px-6 py-2 rounded-xl text-white font-bold text-sm shadow-xl shadow-violet-600/30 group-hover:scale-105 transition-transform\" data-kid=\"153\">\n                    SELECT PLAN\n                </div>\n            </div>\n        </div>\n        <p class=\"mt-16 text-slate-500 text-sm\" data-kid=\"154\">Drag or click around the dial to adjust capacity.</p>\n    </section>\n\n    \n    <section id=\"cta\" class=\"relative py-32 overflow-hidden bg-slate-950\" data-kid=\"155\">\n        <div id=\"split-fold-container\" class=\"container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-10\" data-kid=\"156\">\n            \n            <div class=\"fold-left p-12 bg-[#151A28] border border-slate-800 rounded-3xl lg:rounded-r-none relative overflow-hidden\" data-kid=\"157\">\n                <div class=\"absolute top-0 left-0 w-full h-full bg-gradient-to-br from-violet-600/10 to-transparent\" data-kid=\"158\"></div>\n                <div class=\"relative z-10\" data-kid=\"159\">\n                    <h2 class=\"text-4xl font-bold mb-6\" data-kid=\"160\">Ready to go spatial?</h2>\n                    <p class=\"text-slate-400 text-lg mb-8\" data-kid=\"161\">Join over 2,500+ top-tier mentors and gym owners who have transformed their business with Quantic.</p>\n                    <div class=\"space-y-4\" data-kid=\"162\">\n                        <div class=\"flex items-center gap-4 p-4 bg-white/5 rounded-2xl border border-white/5\" data-kid=\"163\">\n                            <div class=\"w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center text-white\" data-kid=\"164\"><i class=\"fa-solid fa-play\" data-kid=\"165\"></i></div>\n                            <div data-kid=\"166\">\n                                <p class=\"text-white font-bold text-sm\" data-kid=\"167\">Watch the Demo</p>\n                                <p class=\"text-slate-500 text-xs\" data-kid=\"168\">2-minute spatial walkthrough</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            \n            \n            <div class=\"fold-right p-12 bg-violet-600 border border-violet-500 rounded-3xl lg:rounded-l-none relative overflow-hidden\" data-kid=\"169\">\n                <div class=\"absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-white/10 to-transparent\" data-kid=\"170\"></div>\n                <div class=\"relative z-10\" data-kid=\"171\">\n                    <h3 class=\"text-2xl font-bold text-white mb-8\" data-kid=\"172\">Get Started for Free</h3>\n                    <form class=\"space-y-4\" data-kid=\"173\">\n                        <input type=\"email\" placeholder=\"Your work email\" class=\"w-full px-6 py-4 bg-white/10 border border-white/20 rounded-xl text-white placeholder:text-white/50 focus:outline-none focus:bg-white/20 transition-all\" data-kid=\"174\">\n                        <button class=\"w-full py-4 bg-white text-violet-600 font-black rounded-xl hover:bg-slate-100 transition-colors shadow-2xl\" data-kid=\"175\">CREATE ACCOUNT</button>\n                    </form>\n                    <p class=\"mt-6 text-center text-white/60 text-sm\" data-kid=\"176\">No credit card required. Cancel anytime.</p>\n                </div>\n            </div>\n        </div>\n\n        \n        <footer class=\"mt-32 container mx-auto px-6 pt-20 border-t border-white/5\" data-kid=\"177\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12\" data-kid=\"178\">\n                <div class=\"col-span-2\" data-kid=\"179\">\n                    <h4 class=\"font-heading text-2xl font-black mb-6\" data-kid=\"180\">MEMTOR.</h4>\n                    <p class=\"text-slate-500 text-sm leading-relaxed max-w-xs\" data-kid=\"181\">The future of coaching and fitness ecosystem management. Built spatially for the modern entrepreneur.</p>\n                </div>\n                <div data-kid=\"182\">\n                    <h5 class=\"text-white font-bold mb-6\" data-kid=\"183\">Platform</h5>\n                    <ul class=\"space-y-4 text-slate-500 text-sm\" data-kid=\"184\">\n                        <li data-kid=\"185\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"186\">Features</a></li>\n                        <li data-kid=\"187\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"188\">Pricing</a></li>\n                        <li data-kid=\"189\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"190\">Enterprise</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"191\">\n                    <h5 class=\"text-white font-bold mb-6\" data-kid=\"192\">Resources</h5>\n                    <ul class=\"space-y-4 text-slate-500 text-sm\" data-kid=\"193\">\n                        <li data-kid=\"194\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"195\">Documentation</a></li>\n                        <li data-kid=\"196\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"197\">API Reference</a></li>\n                        <li data-kid=\"198\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"199\">Support</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"200\">\n                    <h5 class=\"text-white font-bold mb-6\" data-kid=\"201\">Company</h5>\n                    <ul class=\"space-y-4 text-slate-500 text-sm\" data-kid=\"202\">\n                        <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"204\">About Us</a></li>\n                        <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"206\">Careers</a></li>\n                        <li data-kid=\"207\"><a href=\"#\" class=\"hover:text-white\" data-kid=\"208\">Privacy</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-20 pb-12 flex flex-col md:flex-row justify-between items-center text-slate-600 text-xs gap-4\" data-kid=\"209\">\n                <p data-kid=\"210\">&copy; 2024 Memtor Quantic. All rights reserved.</p>\n                <div class=\"flex gap-6\" data-kid=\"211\">\n                    <a href=\"#\" data-kid=\"212\"><i class=\"fa-brands fa-twitter text-lg\" data-kid=\"213\"></i></a>\n                    <a href=\"#\" data-kid=\"214\"><i class=\"fa-brands fa-linkedin text-lg\" data-kid=\"215\"></i></a>\n                    <a href=\"#\" data-kid=\"216\"><i class=\"fa-brands fa-dribbble text-lg\" data-kid=\"217\"></i></a>\n                </div>\n            </div>\n        </footer>\n    </section>\n</main>\n\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"218\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"219\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"220\"></script>\n<script data-kid=\"221\">gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\" data-kid=\"222\">\n    import { animate } from 'https://esm.sh/animejs@4';\n    import Lenis from \"https://esm.sh/lenis@1\";\n    import Snap from \"https://esm.sh/lenis@1/snap\";\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initialize Lenis\n    const lenis = new Lenis({\n        lerp: 0.1,\n        smoothWheel: true,\n    });\n\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // Snap for the features carousel\n    new Snap(lenis, {\n        wrapper: document.querySelector('.horizontal-scroll-container'),\n        type: 'mandatory',\n    });\n\n    // Anime.js ambient float for hero stack\n    animate('.stack-layer', {\n        translateY: [-10, 10],\n        duration: 3500,\n        direction: 'alternate',\n        loop: true,\n        easing: 'easeInOutQuad',\n        delay: (el, i) => i * 300\n    });\n\n    // GSAP Scroll Driven Narrative: Flatten stack into preview\n    const tl = gsap.timeline({\n        scrollTrigger: {\n            trigger: \"#narrative\",\n            start: \"top 80%\",\n            end: \"top 20%\",\n            scrub: 1.5,\n        }\n    });\n\n    tl.from(\"#product-preview\", {\n        scale: 0.8,\n        rotateX: 45,\n        rotateZ: -20,\n        y: 100,\n        opacity: 0,\n        duration: 1,\n        ease: \"power2.out\"\n    });\n\n    // GSAP Pin Scrub for Hero Transformation\n    gsap.to(\".stack-layer\", {\n        scrollTrigger: {\n            trigger: \"#hero\",\n            start: \"top top\",\n            end: \"bottom center\",\n            scrub: true,\n        },\n        translateZ: 0,\n        rotateX: 0,\n        rotateZ: 0,\n        yPercent: -20,\n        opacity: 0,\n    });\n\n    // GSAP Slide in side for feature grid items\n    gsap.utils.toArray('.feature-card').forEach(card => {\n        gsap.from(card, {\n            scrollTrigger: {\n                trigger: card,\n                start: \"left center+=20%\",\n                horizontal: true,\n                scroller: \".horizontal-scroll-container\"\n            },\n            autoAlpha: 0,\n            x: 50,\n            duration: 0.8,\n            ease: \"power3.out\"\n        });\n    });\n\n    // Mouse movement tilt for product preview\n    const preview = document.querySelector('#product-preview');\n    document.addEventListener('mousemove', (e) => {\n        const x = (e.clientX / window.innerWidth - 0.5) * 20;\n        const y = (e.clientY / window.innerHeight - 0.5) * -20;\n        gsap.to(preview, {\n            rotationY: x,\n            rotationX: y,\n            duration: 1,\n            ease: \"power1.out\"\n        });\n    });\n\n    // Toggle logic visual feedback\n    const toggleBtns = document.querySelectorAll('.toggle-btn');\n    toggleBtns.forEach(btn => {\n        btn.addEventListener('click', () => {\n            toggleBtns.forEach(b => {\n                b.classList.remove('bg-violet-600', 'bg-teal-600', 'text-white');\n                b.classList.add('text-slate-500');\n            });\n            const isGym = btn.innerText === 'Gyms';\n            btn.classList.add(isGym ? 'bg-teal-600' : 'bg-violet-600', 'text-white');\n            btn.classList.remove('text-slate-500');\n            \n            // Visual shift for the whole page\n            gsap.to(':root', {\n                '--violet': isGym ? '#06B6D4' : '#8B5CF6',\n                duration: 0.8\n            });\n        });\n    });\n\n</script>\n",
