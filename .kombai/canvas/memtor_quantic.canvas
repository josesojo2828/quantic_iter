      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;600;700;800&family=Chivo:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n  :root {\n    --color-bg: #F4F6FA;\n    --color-white: #FFFFFF;\n    --color-accent: #7A8CEB;\n    --color-slate: #020617;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-slate);\n    font-family: 'Chivo', sans-serif;\n    margin: 0;\n    overflow-x: clip; /* As per instructions to allow sticky and prevent scrollbars */\n  }\n\n  .font-epilogue { font-family: 'Epilogue', sans-serif; }\n  .font-chivo { font-family: 'Chivo', sans-serif; }\n\n  /* Custom shadow for cards */\n  .shadow-premium {\n    box-shadow: 0 32px 64px -12px rgba(2, 6, 23, 0.08);\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Custom cursor or subtle interactive touches can be added via JS */\n</style>\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n\n    \n    <header class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-12 py-8 pointer-events-none\" data-kid=\"3\">\n      <div class=\"flex items-center gap-8 pointer-events-auto\" data-kid=\"4\">\n        <div class=\"flex items-center gap-2\" data-kid=\"5\">\n          <div class=\"w-8 h-8 bg-[var(--color-accent)] rounded-lg\" data-kid=\"6\"></div>\n          <span class=\"font-epilogue text-2xl font-bold tracking-tighter\" data-kid=\"7\">ITER</span>\n        </div>\n        <nav class=\"hidden md:flex items-center gap-6\" data-kid=\"8\">\n          <a href=\"#\" class=\"font-chivo text-sm font-medium hover:text-[var(--color-accent)]\" data-kid=\"9\">Soluciones</a>\n          <a href=\"#\" class=\"font-chivo text-sm font-medium hover:text-[var(--color-accent)]\" data-kid=\"10\">Precios</a>\n        </nav>\n      </div>\n      \n      <div class=\"flex items-center gap-4 pointer-events-auto\" data-kid=\"11\">\n        <a href=\"#\" class=\"px-6 py-2 rounded-full border border-[var(--color-slate)]/10 text-sm font-medium hover:bg-white transition-colors\" data-kid=\"12\">Acceso Mentor</a>\n        <a href=\"#\" class=\"px-6 py-2 bg-[var(--color-accent)] text-white rounded-full text-sm font-bold shadow-lg hover:shadow-[var(--color-accent)]/40 transition-shadow\" data-kid=\"13\">Empezar Gratis</a>\n      </div>\n    </header>\n\n    \n    <section class=\"relative min-h-[250vh]\" id=\"hero-interactive\" data-kid=\"14\">\n      <div class=\"flex max-w-[1440px] mx-auto px-12\" data-kid=\"15\">\n        \n        <div class=\"w-[40%] sticky top-0 h-screen flex flex-col justify-center pr-20\" data-kid=\"16\">\n          <div class=\"space-y-8\" data-kid=\"17\">\n            <h1 class=\"font-epilogue text-7xl font-extrabold leading-[1.05] tracking-tight text-[var(--color-slate)]\" data-kid=\"18\">\n              Diseñá rutas que <span class=\"text-[var(--color-accent)]\" data-kid=\"19\">transforman</span> vidas.\n            </h1>\n            <p class=\"font-chivo text-xl text-[var(--color-slate)]/60 max-w-md leading-relaxed\" data-kid=\"20\">\n              La infraestructura editorial definitiva para mentores, academias y entrenadores que buscan resultados medibles.\n            </p>\n            \n            \n            <div class=\"inline-flex bg-white/50 backdrop-blur-xl p-1.5 rounded-full border border-[var(--color-slate)]/5 shadow-sm\" id=\"dashboard-switch\" data-kid=\"21\">\n              <button data-state=\"fitness\" class=\"px-8 py-3 rounded-full text-sm font-bold transition-all bg-[var(--color-slate)] text-white shadow-lg\" data-kid=\"22\">Fitness</button>\n              <button data-state=\"mentors\" class=\"px-8 py-3 rounded-full text-sm font-bold transition-all text-[var(--color-slate)]/50 hover:text-[var(--color-slate)]\" data-kid=\"23\">Mentores</button>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"w-[60%] py-40 space-y-40\" data-kid=\"24\">\n          \n          <div class=\"card-reveal bg-white rounded-[32px] p-12 shadow-premium min-h-[600px] flex flex-col\" data-mode=\"fitness\" data-kid=\"25\">\n            <div class=\"flex justify-between items-center mb-10\" data-kid=\"26\">\n              <h3 class=\"font-epilogue text-3xl font-bold\" data-kid=\"27\">Rendimiento Físico</h3>\n              <div class=\"flex gap-2\" data-kid=\"28\">\n                <span class=\"w-3 h-3 rounded-full bg-red-400\" data-kid=\"29\"></span>\n                <span class=\"w-3 h-3 rounded-full bg-amber-400\" data-kid=\"30\"></span>\n                <span class=\"w-3 h-3 rounded-full bg-green-400\" data-kid=\"31\"></span>\n              </div>\n            </div>\n            <div class=\"grid grid-cols-2 gap-8 flex-1\" data-kid=\"32\">\n              <div class=\"bg-[var(--color-bg)] rounded-3xl p-8 flex flex-col justify-between\" data-kid=\"33\">\n                <span class=\"text-sm font-bold opacity-40 uppercase tracking-widest\" data-kid=\"34\">Grasa Corporal</span>\n                <div class=\"text-4xl font-epilogue font-bold text-[var(--color-accent)]\" data-kid=\"35\">14.2%</div>\n                <div class=\"h-2 bg-white rounded-full overflow-hidden\" data-kid=\"36\">\n                  <div class=\"h-full bg-[var(--color-accent)] w-[65%]\" data-kid=\"37\"></div>\n                </div>\n              </div>\n              <div class=\"bg-[var(--color-bg)] rounded-3xl p-8 flex flex-col justify-between\" data-kid=\"38\">\n                <span class=\"text-sm font-bold opacity-40 uppercase tracking-widest\" data-kid=\"39\">Masa Muscular</span>\n                <div class=\"text-4xl font-epilogue font-bold text-emerald-500\" data-kid=\"40\">68.5kg</div>\n                <div class=\"flex items-center gap-2 text-emerald-500 font-bold text-sm\" data-kid=\"41\">\n                  <i class=\"ti ti-trending-up\" data-kid=\"42\"></i> +2.4kg este mes\n                </div>\n              </div>\n              <div class=\"bg-[var(--color-slate)] rounded-3xl p-8 col-span-2 text-white flex justify-between items-center\" data-kid=\"43\">\n                <div data-kid=\"44\">\n                  <h4 class=\"text-xl font-bold mb-2\" data-kid=\"45\">Próxima Sesión: Upper Body</h4>\n                  <p class=\"opacity-60\" data-kid=\"46\">Mañana, 08:30 AM • 12 Ejercicios</p>\n                </div>\n                <button class=\"bg-white/10 hover:bg-white/20 p-4 rounded-full transition-colors\" data-kid=\"47\">\n                  <i class=\"ti ti-arrow-right text-2xl\" data-kid=\"48\"></i>\n                </button>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"card-reveal bg-white rounded-[32px] p-12 shadow-premium min-h-[600px] flex flex-col\" data-mode=\"mentors\" data-kid=\"49\">\n            <div class=\"flex justify-between items-center mb-10\" data-kid=\"50\">\n              <h3 class=\"font-epilogue text-3xl font-bold\" data-kid=\"51\">Progreso Académico</h3>\n              <div class=\"flex gap-2\" data-kid=\"52\">\n                 <div class=\"bg-indigo-50 px-3 py-1 rounded-md text-xs font-bold text-indigo-500\" data-kid=\"53\">SEMANA 12</div>\n              </div>\n            </div>\n            <div class=\"grid grid-cols-2 gap-8 flex-1\" data-kid=\"54\">\n              <div class=\"bg-[#FFF0F5] rounded-3xl p-8\" data-kid=\"55\">\n                <div class=\"flex justify-between items-start mb-4\" data-kid=\"56\">\n                  <i class=\"ti ti-book text-3xl text-pink-500\" data-kid=\"57\"></i>\n                  <span class=\"text-xs font-bold text-pink-400\" data-kid=\"58\">85%</span>\n                </div>\n                <h4 class=\"font-bold mb-1\" data-kid=\"59\">Lectura Crítica</h4>\n                <p class=\"text-sm opacity-50\" data-kid=\"60\">12 libros completados</p>\n              </div>\n              <div class=\"bg-[#D1FAE5] rounded-3xl p-8\" data-kid=\"61\">\n                <div class=\"flex justify-between items-start mb-4\" data-kid=\"62\">\n                  <i class=\"ti ti-edit text-3xl text-emerald-500\" data-kid=\"63\"></i>\n                  <span class=\"text-xs font-bold text-emerald-400\" data-kid=\"64\">Streak: 15d</span>\n                </div>\n                <h4 class=\"font-bold mb-1\" data-kid=\"65\">Journaling</h4>\n                <p class=\"text-sm opacity-50\" data-kid=\"66\">Reflexión diaria activa</p>\n              </div>\n              <div class=\"bg-[var(--color-bg)] rounded-3xl p-10 col-span-2\" data-kid=\"67\">\n                <div class=\"flex items-center justify-between mb-8\" data-kid=\"68\">\n                  <h4 class=\"font-bold text-xl\" data-kid=\"69\">Retención de Conceptos</h4>\n                  <i class=\"ti ti-dots text-2xl opacity-20\" data-kid=\"70\"></i>\n                </div>\n                <div class=\"flex items-end gap-3 h-32\" data-kid=\"71\">\n                  <div class=\"flex-1 bg-[var(--color-accent)]/20 rounded-t-lg h-[40%]\" data-kid=\"72\"></div>\n                  <div class=\"flex-1 bg-[var(--color-accent)]/20 rounded-t-lg h-[60%]\" data-kid=\"73\"></div>\n                  <div class=\"flex-1 bg-[var(--color-accent)]/20 rounded-t-lg h-[45%]\" data-kid=\"74\"></div>\n                  <div class=\"flex-1 bg-[var(--color-accent)]/20 rounded-t-lg h-[90%]\" data-kid=\"75\"></div>\n                  <div class=\"flex-1 bg-[var(--color-accent)] rounded-t-lg h-[75%]\" data-kid=\"76\"></div>\n                  <div class=\"flex-1 bg-[var(--color-accent)] rounded-t-lg h-[100%]\" data-kid=\"77\"></div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"py-32 px-12 overflow-hidden\