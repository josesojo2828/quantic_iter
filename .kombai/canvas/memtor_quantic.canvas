div>\n                    <p class=\"mt-6 text-white/30 text-xs font-medium uppercase tracking-widest\" data-kid=\"194\">Global infrastructure for multi-region organizations.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 px-10 hairline-b bg-white/[0.01]\" data-kid=\"195\">\n        <div class=\"grid grid-cols-12 gap-12\" data-kid=\"196\">\n            <div class=\"col-span-12 lg:col-span-6\" data-kid=\"197\">\n                <h2 class=\"font-outfit text-7xl md:text-8xl uppercase font-black leading-[0.85] tracking-tighter\" data-kid=\"198\">START<br data-kid=\"199\">SCALING<br data-kid=\"200\">TODAY.</h2>\n            </div>\n            <div class=\"col-span-12 lg:col-span-6 flex flex-col justify-end\" data-kid=\"201\">\n                <form class=\"space-y-12 max-w-xl ml-auto w-full\" data-kid=\"202\">\n                    <div class=\"relative group\" data-kid=\"203\">\n                        <label class=\"block font-outfit text-[10px] font-bold text-white/40 uppercase tracking-[0.4em] mb-4\" data-kid=\"204\">Academy_Name</label>\n                        <input type=\"text\" class=\"w-full bg-transparent border-b border-white/10 py-4 font-outfit text-2xl outline-none focus:border-white transition-colors placeholder:text-white/5\" placeholder=\"Enter identification\" data-kid=\"205\">\n                    </div>\n                    <div class=\"relative group\" data-kid=\"206\">\n                        <label class=\"block font-outfit text-[10px] font-bold text-white/40 uppercase tracking-[0.4em] mb-4\" data-kid=\"207\">Email_Address</label>\n                        <input type=\"email\" class=\"w-full bg-transparent border-b border-white/10 py-4 font-outfit text-2xl outline-none focus:border-white transition-colors placeholder:text-white/5\" placeholder=\"protocol@address.net\" data-kid=\"208\">\n                    </div>\n                    <button class=\"w-full md:w-auto bg-white text-black font-outfit font-black text-xl uppercase tracking-tighter px-12 py-6 hover:bg-white/90 transition-all flex items-center justify-between group\" data-kid=\"209\">\n                        Provision Account\n                        <svg class=\"w-6 h-6 transition-transform group-hover:translate-x-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" data-kid=\"210\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" data-kid=\"211\"></path></svg>\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"px-10 py-12\" data-kid=\"212\">\n        <div class=\"flex flex-col md:flex-row items-center justify-between gap-8\" data-kid=\"213\">\n            <div class=\"font-outfit text-xl font-black tracking-tighter uppercase\" data-kid=\"214\">Memtor<span class=\"text-white/20\" data-kid=\"215\">Quantic</span></div>\n            <div class=\"flex items-center gap-10 text-[10px] font-bold uppercase tracking-[0.3em] text-white/30\" data-kid=\"216\">\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"217\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"218\">Terms</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"219\">Nodes</a>\n                <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"220\">GitHub</a>\n            </div>\n            <div class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-white/20\" data-kid=\"221\">© 2024 MQ_LABS_SYSTEM</div>\n        </div>\n    </footer>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"222\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"223\"></script>\n<script type=\"module\" data-kid=\"224\">\n    import { animate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initial load animations\n    gsap.from(\"#main-headline\", {\n        y: 100,\n        opacity: 0,\n        duration: 1.2,\n        ease: \"power4.out\"\n    });\n\n    // Toggle logic\n    const mentorBtn = document.getElementById('toggle-mentor');\n    const gymBtn = document.getElementById('toggle-gym');\n    \n    const mentorInd = document.getElementById('mentor-indicator');\n    const gymInd = document.getElementById('gym-indicator');\n    \n    const mentorTitle = document.getElementById('mentor-title');\n    const gymTitle = document.getElementById('gym-title');\n    \n    const mentorDesc = document.getElementById('mentor-desc');\n    const gymDesc = document.getElementById('gym-desc');\n\n    const previewTag = document.getElementById('preview-tag');\n    const previewTitle = document.getElementById('preview-title');\n    const previewDesc = document.getElementById('preview-desc');\n    const previewAccentBar = document.getElementById('preview-accent-bar');\n    const previewBarActive = document.getElementById('preview-bar-active');\n    const rampBar = document.getElementById('ramp-bar');\n\n    mentorBtn.addEventListener('click', () => {\n        gsap.to(mentorInd, { scaleX: 1, duration: 0.5 });\n        gsap.to(gymInd, { scaleX: 0, duration: 0.5 });\n        \n        mentorTitle.classList.remove('text-white/20');\n        gymTitle.classList.add('text-white/20');\n        \n        mentorDesc.classList.remove('text-white/10');\n        mentorDesc.classList.add('text-white/40');\n        gymDesc.classList.remove('text-white/40');\n        gymDesc.classList.add('text-white/10');\n\n        // Update theme globally\n        document.documentElement.style.setProperty('--mentor-accent', '#6366F1');\n        previewTag.innerText = \"01 / DASHBOARD LOGIC\";\n        previewTag.style.color = '#6366F1';\n        previewTitle.innerHTML = \"DATA<br/>STRUCTURALISM\";\n        previewAccentBar.style.backgroundColor = '#6366F1';\n        previewBarActive.style.backgroundColor = '#6366F1';\n        rampBar.style.backgroundColor = '#6366F1';\n    });\n\n    gymBtn.addEventListener('click', () => {\n        gsap.to(gymInd, { scaleX: 1, duration: 0.5 });\n        gsap.to(mentorInd, { scaleX: 0, duration: 0.5 });\n        \n        gymTitle.classList.remove('text-white/20');\n        mentorTitle.classList.add('text-white/20');\n        \n        gymDesc.classList.remove('text-white/10');\n        gymDesc.classList.add('text-white/40');\n        mentorDesc.classList.remove('text-white/40');\n        mentorDesc.classList.add('text-white/10');\n\n        // Update theme globally\n        document.documentElement.style.setProperty('--mentor-accent', '#10B981');\n        previewTag.innerText = \"02 / ACADEMY SYSTEM\";\n        previewTag.style.color = '#10B981';\n        previewTitle.innerHTML = \"BIOMETRIC<br/>ROUTING\";\n        previewAccentBar.style.backgroundColor = '#10B981';\n        previewBarActive.style.backgroundColor = '#10B981';\n        rampBar.style.backgroundColor = '#10B981';\n    });\n\n    // Scroll reveals\n    gsap.utils.toArray('.ramp-item').forEach((item, i) => {\n        gsap.from(item, {\n            scrollTrigger: {\n                trigger: item,\n                start: \"top bottom-=100\"\n            },\n            height: 0,\n            opacity: 0,\n            duration: 1.5,\n            delay: i * 0.1,\n            ease: \"power4.out\"\n        });\n    });\n\n    // Mockup parallax\n    gsap.to(\"#mockup-container\", {\n        scrollTrigger: {\n            trigger: \"#mockup-container\",\n            start: \"top bottom\",\n            end: \"bottom top\",\n            scrub: 1\n        },\n        y: -100,\n        x: -50,\n        rotateZ: -2\n    });\n\n</script>\n</div>",
