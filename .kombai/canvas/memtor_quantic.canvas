op-blur-sm border border-white/10\" data-kid=\"190\">\n              <div class=\"flex -space-x-4\" data-kid=\"191\">\n                <img src=\"https://i.pravatar.cc/100?u=a\" class=\"w-14 h-14 rounded-full border-4 border-[#7A8CEB]\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"192\">\n                <img src=\"https://i.pravatar.cc/100?u=b\" class=\"w-14 h-14 rounded-full border-4 border-[#7A8CEB]\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"193\">\n                <img src=\"https://i.pravatar.cc/100?u=c\" class=\"w-14 h-14 rounded-full border-4 border-[#7A8CEB]\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"194\">\n              </div>\n              <div class=\"font-chivo\" data-kid=\"195\">\n                <div class=\"font-bold text-lg\" data-kid=\"196\">+2.4k Mentores</div>\n                <div class=\"text-sm opacity-60\" data-kid=\"197\">Confían en nuestra infraestructura</div>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"absolute bottom-0 right-0 w-64 h-64 bg-white/5 rounded-full -mr-20 -mb-20 blur-3xl\" data-kid=\"198\"></div>\n        </div>\n\n        \n        <div class=\"w-full lg:w-1/2 p-20 flex flex-col justify-center\" data-kid=\"199\">\n          <form class=\"space-y-10\" onsubmit=\"event.preventDefault()\" data-kid=\"200\">\n            <div data-kid=\"201\">\n              <label class=\"block font-epilogue text-sm font-bold mb-4 text-[var(--color-slate)]/40 uppercase tracking-[0.2em]\" data-kid=\"202\">Correo Electrónico Corporativo</label>\n              <input type=\"email\" placeholder=\"nombre@tuacademia.com\" class=\"w-full bg-[var(--color-bg)] border-2 border-transparent focus:border-[var(--color-accent)]/20 rounded-3xl p-8 font-chivo text-xl outline-none transition-all placeholder:text-[var(--color-slate)]/20\" data-kid=\"203\">\n            </div>\n            <div class=\"space-y-4\" data-kid=\"204\">\n              <button class=\"w-full bg-[var(--color-accent)] text-white font-epilogue font-extrabold py-8 rounded-[24px] text-2xl shadow-[0_20px_40px_-10px_rgba(122,140,235,0.4)] hover:shadow-[0_30px_60px_-15px_rgba(122,140,235,0.6)] transition-all hover:-translate-y-1\" data-kid=\"205\">\n                Solicitar Acceso Privado\n              </button>\n              <p class=\"text-center font-chivo text-sm text-[var(--color-slate)]/30\" data-kid=\"206\">\n                Al continuar, aceptas nuestros <a href=\"#\" class=\"underline\" data-kid=\"207\">Términos de Servicio</a> y <a href=\"#\" class=\"underline\" data-kid=\"208\">Privacidad</a>.\n              </p>\n            </div>\n          </form>\n        </div>\n      </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-12 border-t border-[var(--color-slate)]/5 bg-white/50\" data-kid=\"209\">\n      <div class=\"max-w-[1440px] mx-auto flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"210\">\n        <div class=\"flex items-center gap-3\" data-kid=\"211\">\n          <div class=\"w-10 h-10 bg-[var(--color-accent)] rounded-xl\" data-kid=\"212\"></div>\n          <span class=\"font-epilogue text-2xl font-bold tracking-tighter\" data-kid=\"213\">ITER</span>\n        </div>\n        \n        <div class=\"flex gap-12 text-sm font-bold text-[var(--color-slate)]/40 uppercase tracking-widest\" data-kid=\"214\">\n          <a href=\"#\" class=\"hover:text-[var(--color-slate)] transition-colors\" data-kid=\"215\">Privacidad</a>\n          <a href=\"#\" class=\"hover:text-[var(--color-slate)] transition-colors\" data-kid=\"216\">Seguridad</a>\n          <a href=\"#\" class=\"hover:text-[var(--color-slate)] transition-colors\" data-kid=\"217\">Prensa</a>\n        </div>\n\n        <div class=\"flex gap-6\" data-kid=\"218\">\n          <a href=\"#\" class=\"w-12 h-12 rounded-full bg-white border border-[var(--color-slate)]/5 flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-white transition-all\" data-kid=\"219\">\n            <i class=\"ti ti-brand-x\" data-kid=\"220\"></i>\n          </a>\n          <a href=\"#\" class=\"w-12 h-12 rounded-full bg-white border border-[var(--color-slate)]/5 flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-white transition-all\" data-kid=\"221\">\n            <i class=\"ti ti-brand-linkedin\" data-kid=\"222\"></i>\n          </a>\n        </div>\n      </div>\n      <div class=\"max-w-[1440px] mx-auto mt-12 text-center text-[var(--color-slate)]/20 text-xs font-medium\" data-kid=\"223\">\n        &copy; 2024 Quantic Lab. Todos los derechos reservados. Diseñado por y para el crecimiento.\n      </div>\n    </footer>\n\n  </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"224\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"225\"></script>\n<script type=\"module\" data-kid=\"226\">\n  import Lenis from \"https://esm.sh/lenis@1\";\n  import Snap from \"https://esm.sh/lenis@1/snap\";\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize Lenis\n  const lenis = new Lenis({\n    autoRaf: true,\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    smoothWheel: true\n  });\n\n  // Export for global access if needed by GSAP\n  window.lenis = lenis;\n\n  // 1. Sticky Scroll Hero Animation\n  const cards = gsap.utils.toArray('.card-reveal');\n  const switchBtns = document.querySelectorAll('#dashboard-switch button');\n\n  cards.forEach((card, i) => {\n    ScrollTrigger.create({\n      trigger: card,\n      start: \"top 50%\",\n      end: \"bottom 50%\",\n      onToggle: self => {\n        if (self.isActive) {\n          const mode = card.dataset.mode;\n          updateSwitch(mode);\n        }\n      }\n    });\n\n    // Entrance Animation for Cards\n    gsap.from(card, {\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: card,\n        start: \"top 85%\",\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n\n  function updateSwitch(mode) {\n    switchBtns.forEach(btn => {\n      if (btn.dataset.state === mode) {\n        btn.classList.add('bg-[var(--color-slate)]', 'text-white', 'shadow-lg');\n        btn.classList.remove('text-[var(--color-slate)]/50');\n      } else {\n        btn.classList.remove('bg-[var(--color-slate)]', 'text-white', 'shadow-lg');\n        btn.classList.add('text-[var(--color-slate)]/50');\n      }\n    });\n  }\n\n  // 2. Staircase Animation\n  const staircaseItems = gsap.utils.toArray('.staircase-item');\n  staircaseItems.forEach((item, i) => {\n    gsap.from(item, {\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      delay: i * 0.2,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: \"#how-it-works\",\n        start: \"top 60%\",\n      }\n    });\n  });\n\n  // 3. Horizontal Carousel Parallax (Subtle)\n  gsap.to(\"#carousel-track\", {\n    xPercent: -20,\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \"#use-cases\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    }\n  });\n\n  // 4. Accordion Functionality\n  const accordionItems = document.querySelectorAll('.accordion-item');\n  accordionItems.forEach(item => {\n    const trigger = item.querySelector('.accordion-trigger');\n    trigger.addEventListener('click', () => {\n      const isOpen = item.dataset.open === 'true';\n      \n      // Close others\n      accordionItems.forEach(other => {\n        if (other !== item) {\n          other.dataset.open = 'false';\n          other.querySelector('i.ti-chevron-down')?.classList.remove('rotate-180');\n          other.querySelector('h3').classList.add('text-[var(--color-slate)]/40');\n        }\n      });\n\n      // Toggle current\n      item.dataset.open = !isOpen;\n      const icon = item.querySelector('i.ti-chevron-down');\n      if (icon) {\n        if (!isOpen) {\n          icon.classList.add('rotate-180');\n          item.querySelector('h3').classList.remove('text-[var(--color-slate)]/40');\n        } else {\n          icon.classList.remove('rotate-180');\n          item.querySelector('h3').classList.add('text-[var(--color-slate)]/40');\n        }\n      }\n    });\n  });\n\n  // 5. Final CTA Scaling (#locomotive-progress-hero logic)\n  gsap.from(\".cta-inner\", {\n    scale: 0.95,\n    borderRadius: \"80px\",\n    duration: 1.5,\n    ease: \"power2.out\",\n    scrollTrigger: {\n      trigger: \"#cta\",\n      start: \"top 90%\",\n      end: \"top 20%\",\n      scrub: true\n    }\n  });\n\n</script>\n",
